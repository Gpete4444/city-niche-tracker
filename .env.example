# Setup guide (non-technical): docs/ENV-SETUP.md
# DataForSEO API credentials (https://app.dataforseo.com/api-access)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Stage 1 uses SERP + Keywords Data.
# Stage 2 (enrich-candidate) also needs the Backlinks API product funded.
# Stage 3 (prospect-renters) uses Maps SERP + organic SERP.

# Anthropic (Rover dashboard Claude narrative / outreach — draft then Accept)
ANTHROPIC_API_KEY=
# Required for identity-linked / multi-workspace keys (Console → Settings → Workspaces)
# ANTHROPIC_WORKSPACE_ID=wrkspc_…
# Optional overrides (defaults: claude-sonnet-5, medium effort)
# ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_EFFORT=medium
# Admin API key for API Cost balance (Console → Settings → Admin keys; sk-ant-admin01-…)
# ANTHROPIC_ADMIN_KEY=
# Optional override: total purchased credits in USD. Normally fetched automatically.
# ANTHROPIC_CREDIT_BALANCE=

# OpenAI (Phone tab: Whisper STT + gpt-4o-mini summaries)
OPENAI_API_KEY=
# Optional overrides
# OPENAI_PHONE_TRANSCRIBE_MODEL=whisper-1
# OPENAI_PHONE_MODEL=gpt-4o-mini

# Business address finder (Site-Config → Address step — commercial LoopNet/Crexi + Places screen)
# P0 (home paste / skip) works without these. Find addresses needs Google Maps + APIFY_TOKEN
# and at least one of APIFY_LOOPNET_ACTOR_ID / APIFY_CREXI_ACTOR_ID.
# Google Cloud: enable billing + Places API (New); restrict the key to Places (New) + Geocoding.
# https://console.cloud.google.com/apis/library/places.googleapis.com
GOOGLE_MAPS_API_KEY=
# Apify: https://console.apify.com/settings/integrations — prefer actors ~$1.20–$1.50 / 1K results
APIFY_TOKEN=
# Actor ids from the Apify Store page (use ~ form), e.g. solidcode~loopnet-com-scraper
APIFY_LOOPNET_ACTOR_ID=
APIFY_CREXI_ACTOR_ID=
# Optional caps (defaults applied in code when unset)
# maxItems per search URL on first pull (default 200, absolute max 2000). Per-source budgets.
# City ceiling starts at 500/URL and doubles on confirm when Fetch deeper would exceed it.
# ADDRESS_SEARCH_MAX_LISTINGS=200
# Find: listing events ~$1.30/1K; Places Text Search est. $0.032/call.
# Re-Find uses a 7-day city cache (Apify $0) unless you Refresh / Fetch deeper for that source.

# Ops dashboard port (bound to 127.0.0.1 only)
# OPS_PORT=8787

# Parallel Prepare / Launch (single Rover process)
# Preview port pool: base + slots (default 4322–4327 when slots=6)
# ASSEMBLED_PREVIEW_PORT_BASE=4322
# ASSEMBLED_PREVIEW_SLOTS=6
# Max concurrent assemble/ship/launch/preview jobs (default 2, hard max 6).
# Runtime override also available in Rover Settings → Jobs K (persists under research/_rover/).
# ROVER_SHIP_CONCURRENCY=2

# Template GitHub repo (optional; also detected via `git remote get-url origin`)
# TEMPLATE_GITHUB_REPO=7D7D/Rover

# Owner/org for per-site repos created by Launch auto-ship (via `gh`)
# One-time: install GitHub CLI and run `gh auth login` on this machine
# GITHUB_OWNER=7D7D

# Where Assemble writes sibling site folders (default: ../rover-sites)
# ASSEMBLED_SITES_DIR=C:\Repos\rover-sites

# Cloudflare launch automation (Rover Launch / npm run launch-site)
# API calls are free; create a token at https://dash.cloudflare.com/profile/api-tokens
# Suggested permissions: Account Workers Scripts (Edit), Account Settings (Read),
# Account Email Routing Addresses (Edit), Account Turnstile (Edit),
# Zone (Read), Zone DNS (Edit), Zone Email Routing Rules (Edit)
# Optional for push-to-deploy: Account → Workers Builds Configuration (Edit)
# (Keep Workers Scripts Edit.) Official Builds docs do not require a separate
# "Workers CI" row in the token UI — that name is API-internal and often hidden.
# One-time: authorize GitHub via any Worker → Settings → Builds → Connect (click Connect).
# Must be a **user** API token (account-owned tokens fail Builds API).
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# Default Gmail (or inbox) for Cloudflare Email Routing destination + Web3Forms notify hint
# WEB3FORMS_DEFAULT_NOTIFY_EMAIL=you@gmail.com

# Stock photos for Structure “Include photos” (optional; Pull images / auto on Content Accept)
# https://unsplash.com/oauth/applications · https://www.pexels.com/api/ · https://pixabay.com/api/docs/
# UNSPLASH_ACCESS_KEY=
# PEXELS_API_KEY=
# PIXABAY_API_KEY=
# IMAGE_SOURCES=unsplash,pexels,pixabay
# GPT Image generate (Review / Photo) uses OPENAI_API_KEY — same key as Phone.

# Discovery census places file (incorporated places population CSV)
# Default: data/census/SUB-IP-EST2025-POP.csv (in-repo)
# CENSUS_POP_CSV=data/census/SUB-IP-EST2025-POP.csv

# Call tracking (Sites provisioner — NOT Launch). See docs/PHONE-TRACKING.md
# Twilio-only: ranking DID → TWILIO_FORWARD_TO; on rent, same DID → renter.phone.
# Phone tab syncs Calls/Recordings from Twilio REST (durable; no tunnel required).
# Optional live webhook relay while Rover is reachable:
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FORWARD_TO=+1XXXXXXXXXX
# TWILIO_VOICE_WEBHOOK_URL=https://rover-voice-xxxx.twil.io/inbound
# ROVER_PHONE_WEBHOOK_SECRET=generate-a-long-random-string
# ROVER_PUBLIC_WEBHOOK_BASE=https://your-tunnel.example   # optional; set ROVER_WEBHOOK_URL on Twilio Functions for live relay
# CallRail cancelled — do not use for new cutovers.

# Google Search Console (Launched Sites traffic metrics)
# Create a Desktop OAuth client in Google Cloud (enable Search Console API).
# Redirect URI used by Rover: http://127.0.0.1:8787/api/gsc/oauth/callback
# If Desktop client rejects the redirect, create a Web application client with that URI instead.
# GOOGLE_GSC_CLIENT_ID=
# GOOGLE_GSC_CLIENT_SECRET=
