# DataForSEO API credentials (https://app.dataforseo.com/api-access)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Stage 1 uses SERP + Keywords Data.
# Stage 2 (enrich-candidate) also needs the Backlinks API product funded.
# Stage 3 (prospect-renters) uses Maps SERP + organic SERP.

# Anthropic (ops dashboard Claude narrative / outreach — draft then Accept)
ANTHROPIC_API_KEY=
# Optional override (default: claude-sonnet-4-20250514)
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Ops dashboard port (bound to 127.0.0.1 only)
# OPS_PORT=8787

# Template GitHub repo (optional; also detected via `git remote get-url origin`)
# TEMPLATE_GITHUB_REPO=7D7D/rank-and-rent-template

# Where Assemble writes sibling site folders (default: ../rank-and-rent-sites)
# ASSEMBLED_SITES_DIR=C:\Repos\rank-and-rent-sites

# Cloudflare launch automation (ops Launch / npm run launch-site)
# API calls are free; create a token at https://dash.cloudflare.com/profile/api-tokens
# Suggested permissions: Account Workers Scripts (Edit), Account Turnstile (Edit),
# Zone Email Routing (Edit), Zone DNS (Edit), Zone Settings (Read)
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# Default Gmail (or inbox) for Cloudflare Email Routing destination + Web3Forms notify hint
# WEB3FORMS_DEFAULT_NOTIFY_EMAIL=you@gmail.com

# Discovery census places file (incorporated places population CSV)
# Default: data/census/SUB-IP-EST2025-POP.csv (in-repo)
# CENSUS_POP_CSV=data/census/SUB-IP-EST2025-POP.csv
