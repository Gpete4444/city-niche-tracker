---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import LeadForm from '../../components/LeadForm.astro';
import ServicePageSections from '../../components/ServicePageSections.astro';
import { site } from '../../config/site';
import { filterServicesForSite } from '../../lib/services-for-site';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services
    .filter((entry) => !entry.data.draft)
    .map((entry) => ({
      params: { slug: entry.id },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const allServices = filterServicesForSite(await getCollection('services'), site).filter(
  (e) => !e.data.draft && e.id !== entry.id,
);
const related = allServices.slice(0, 4).map((e) => ({
  href: `/services/${e.id}`,
  title: e.data.serviceName,
  description: e.data.description,
}));
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  pageType="service"
  serviceName={entry.data.serviceName}
>
  <Hero
    h1={entry.data.h1}
    supporting={entry.data.description}
    image={entry.data.heroImage ?? entry.data.cardImage}
  />
  <ServicePageSections
    body={entry.body || ''}
    h1={entry.data.h1}
    title={entry.data.title}
    serviceName={entry.data.serviceName}
    related={related}
  />
  <LeadForm heading={`Ask about ${entry.data.serviceName}`} />
</BaseLayout>
