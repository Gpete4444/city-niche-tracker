---
import { existsSync } from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { getEntry, getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ServiceCards from '../components/ServiceCards.astro';
import HomeSections from '../components/HomeSections.astro';
import TrustSignals from '../components/TrustSignals.astro';
import TwoToneHeading from '../components/TwoToneHeading.astro';
import { site, siteShowsServiceCards, socialProofHasTrustStrip } from '../config/site';
import { filterLocationsForSite, alsoServingLinks } from '../lib/locations-for-site';
import { locationPath } from '../lib/site-path';
import { bandSurface } from '../lib/section-surfaces';
import { ve } from '../lib/visual-edit';
import {
  extractHomepageIntro,
  extractHomepageProseSections,
  homepageUsesStructuredSections,
  proseSectionEyebrow,
} from '../lib/content-body';
import { HOME_SECTIONS_BODY_KEYS, orderedHomeSectionKeys } from '../lib/home-section-order';

/** Prefer FM coverageMap; fall back when SVG is on disk (Accept/Stage may omit FM). */
function resolveCoverageMap(
  fmMap: { src?: string; alt?: string } | undefined,
  primaryCity: string,
): { src: string; alt: string } | undefined {
  if (fmMap?.src) {
    return { src: fmMap.src, alt: fmMap.alt || `Coverage map for ${primaryCity} area` };
  }
  const rel = ['public', 'images', 'coverage-map.svg'];
  const candidates = [
    path.join(process.cwd(), ...rel),
    path.join(path.dirname(fileURLToPath(import.meta.url)), '..', ...rel),
  ];
  if (candidates.some((abs) => existsSync(abs))) {
    return {
      src: '/images/coverage-map.svg',
      alt: `Coverage map for ${primaryCity} area`,
    };
  }
  return undefined;
}

const indexEntry = await getEntry('pages', 'index');
if (!indexEntry) {
  throw new Error('Missing src/content/pages/index.md');
}

const { Content } = await render(indexEntry);

const locationEntries = filterLocationsForSite(
  (await getCollection('locations')).filter((e) => !e.data.draft),
  site,
);
/** Real location pages only (primary + targetSuburbs) — never full coverage list. */
const locations = locationEntries.map((e) => ({
  id: e.id,
  city: e.data.city,
  state: e.data.state,
  href: locationPath(e.id),
}));
const alsoServing = alsoServingLinks(site);

const sectionList = Array.isArray(site.homepageSections) ? site.homepageSections : null;
const showSection = (key: string) => !sectionList || sectionList.includes(key);
const showServices = siteShowsServiceCards() && showSection('services');
const showOfferProcess =
  showSection('offerProcess') ||
  (site.siteArchetype === 'single_service' && showSection('process'));
const social = site.socialProof;
const showTrust = showSection('trust') && socialProofHasTrustStrip(social);
const showIntro = showSection('intro');
const showWhy = showSection('whyChooseUs');
const showProcess = showSection('process') || showOfferProcess;
const showAreas = showSection('areas') && locations.length > 0;
const showFaqs = showSection('faqs');
const showGallery = showSection('gallery') || showSection('beforeAfter');
const showReviews = showSection('reviews');
const showCta = showSection('cta');

const pageOrder = orderedHomeSectionKeys(sectionList);
const structured = homepageUsesStructuredSections(sectionList);
const proseOnlyKeys = ['cost', 'materials', 'timeline', 'codes', 'diyVsPro', 'whenToCall'];
const enabledProseKeys = pageOrder.filter((k) => proseOnlyKeys.includes(k) && showSection(k));
const wantsProseExtras = enabledProseKeys.length > 0;
const showProseBody = showIntro || wantsProseExtras;

const rawBody = typeof indexEntry.body === 'string' ? indexEntry.body : '';
const introParagraphs = structured
  ? extractHomepageIntro(rawBody, {
      h1: indexEntry.data.h1,
      title: indexEntry.data.title,
      sectionHeading: indexEntry.data.sectionHeading,
      maxParagraphs: 2,
    })
  : [];

const proseSections = structured
  ? extractHomepageProseSections(rawBody, {
      h1: indexEntry.data.h1,
      title: indexEntry.data.title,
      sectionHeading: indexEntry.data.sectionHeading,
      enabledIds: enabledProseKeys,
    }).map((s) => ({
      id: s.id,
      heading: s.heading,
      body: s.body,
      eyebrow: proseSectionEyebrow(s.id),
    }))
  : [];

const featureImage = indexEntry.data.featureImage;
const featureSrc = String(featureImage?.src || '').trim();
const featurePublicPath = featureSrc.replace(/^\//, '').replace(/^public\//, '');
const showFeatureImage = Boolean(
  featureImage &&
    featureSrc &&
    (/^https?:\/\//i.test(featureSrc) ||
      (featurePublicPath &&
        existsSync(path.join(process.cwd(), 'public', ...featurePublicPath.split('/'))))),
);

const showIntroSection =
  showIntro && (structured ? introParagraphs.length > 0 : showProseBody);

type PageSlot =
  | { kind: 'trust' }
  | { kind: 'intro'; surface: string }
  | { kind: 'services'; surface: string }
  | { kind: 'body'; key: string; bandStart: number };

const slots: PageSlot[] = [];
let lightBand = 0;
for (const key of pageOrder) {
  if (key === 'trust') {
    if (showTrust) slots.push({ kind: 'trust' });
    continue;
  }
  if (key === 'intro') {
    if (showIntroSection) slots.push({ kind: 'intro', surface: bandSurface(lightBand++) });
    continue;
  }
  if (key === 'services') {
    if (showServices) slots.push({ kind: 'services', surface: bandSurface(lightBand++) });
    continue;
  }
  if (!HOME_SECTIONS_BODY_KEYS.has(key)) continue;
  const bandStart = lightBand;
  // Reserve a light band for sections that use alternating paper (not brand/ink).
  if (key !== 'areas' && key !== 'cta') lightBand += 1;
  slots.push({ kind: 'body', key, bandStart });
}

const homeSectionsProps = {
  editFile: 'src/content/pages/index.md',
  whyChooseUs: showWhy ? indexEntry.data.whyChooseUs : [],
  process: showProcess ? indexEntry.data.process : [],
  processHeading: showOfferProcess ? `How ${site.services[0] ?? site.niche} works` : undefined,
  whyHeading: `Why choose ${site.businessName}`,
  faqs: showFaqs ? indexEntry.data.faqs : [],
  gallery: showGallery ? indexEntry.data.gallery : [],
  materialsImages: indexEntry.data.materialsImages || [],
  coverageMap: showAreas
    ? resolveCoverageMap(indexEntry.data.coverageMap, site.primaryCity)
    : undefined,
  locations: showAreas ? locations : [],
  alsoServing: showAreas ? alsoServing : [],
  proseSections,
  showReviews,
  showCta,
};
---

<BaseLayout
  title={indexEntry.data.title}
  description={indexEntry.data.description}
  pageType="home"
  ogImage={indexEntry.data.heroImage?.src}
  faqs={showFaqs ? indexEntry.data.faqs : []}
>
  {
    showSection('hero') && (
      <Hero
        h1={indexEntry.data.h1}
        supporting={site.tagline}
        showForm
        image={indexEntry.data.heroImage}
        editFile="src/content/pages/index.md"
        supportingKey="tagline"
        heroSlotKey="hero-1"
      />
    )
  }

  {
    slots.map((slot) => (
      <>
        {slot.kind === 'trust' && <TrustSignals />}

        {slot.kind === 'intro' && (
          <section class={slot.surface} aria-labelledby="intro-heading" data-section="intro">
            <div
              class:list={[
                'mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16',
                showFeatureImage && 'grid items-center gap-8 md:grid-cols-2 md:gap-12',
              ]}
            >
              <div>
                <div class="max-w-3xl">
                  <p class="section-eyebrow">{site.niche}</p>
                  {
                    showIntro && (
                      <div
                        data-edit={ve({
                          type: 'fm',
                          file: 'src/content/pages/index.md',
                          key: 'sectionHeading',
                          kind: 'heading',
                        })}
                      >
                        <TwoToneHeading
                          as="h2"
                          id="intro-heading"
                          mode="plain"
                          text={
                            indexEntry.data.sectionHeading ?? `${site.niche} in ${site.primaryCity}`
                          }
                          class="mt-2 heading-section"
                        />
                      </div>
                    )
                  }
                </div>
                <div class="prose-site mt-5 max-w-3xl">
                  {
                    structured ? (
                      introParagraphs.map((p) => <p>{p}</p>)
                    ) : (
                      <Content />
                    )
                  }
                </div>
              </div>
              {
                showFeatureImage && featureImage && (
                  <img
                    src={featureImage.src}
                    alt={featureImage.alt}
                    class="aspect-[4/3] w-full rounded-xl object-cover shadow-lg"
                    width="900"
                    height="675"
                    loading="lazy"
                    data-edit={ve({
                      type: 'image',
                      file: 'src/content/pages/index.md',
                      key: 'featureImage',
                      kind: 'image',
                    })}
                  />
                )
              }
            </div>
          </section>
        )}

        {slot.kind === 'services' && (
          <ServiceCards
            heading={`${site.niche} services`}
            surface={slot.surface}
            cardImages={indexEntry.data.serviceCardImages || []}
          />
        )}

        {slot.kind === 'body' && (
          <HomeSections {...homeSectionsProps} sectionOrder={[slot.key]} bandStart={slot.bandStart} />
        )}
      </>
    ))
  }
</BaseLayout>
