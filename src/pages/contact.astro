---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import LeadForm from '../components/LeadForm.astro';
import { stripLeadingTitleEcho } from '../lib/content-body';

const entry = await getEntry('pages', 'contact');
if (!entry) {
  throw new Error('Missing src/content/pages/contact.md');
}
const { Content } = await render(entry);
const rawBody = typeof entry.body === 'string' ? entry.body : '';
const bodyWithoutEcho = stripLeadingTitleEcho(rawBody, entry.data.h1, entry.data.title);
const hasExtraProse = bodyWithoutEcho.trim().length > 80;
---

<BaseLayout title={entry.data.title} description={entry.data.description} pageType="page">
  <Hero h1={entry.data.h1} supporting={entry.data.description} image={entry.data.heroImage} editFile="src/content/pages/contact.md" supportingKey="description" />
  <LeadForm heading="Get a Free Estimate" />
  {
    hasExtraProse && (
      <section class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
        <div class="prose-site max-w-3xl contact-prose">
          <Content />
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .contact-prose :global(> :is(h1, h2):first-child) {
    display: none;
  }
</style>
