---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import LeadForm from '../components/LeadForm.astro';

const entry = await getEntry('pages', 'contact');
if (!entry) {
  throw new Error('Missing src/content/pages/contact.md');
}
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description} pageType="page">
  <Hero h1={entry.data.h1} supporting={entry.data.description} image={entry.data.heroImage} />
  <section class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
    <div class="prose-site max-w-3xl">
      <Content />
    </div>
  </section>
  <LeadForm />
</BaseLayout>
