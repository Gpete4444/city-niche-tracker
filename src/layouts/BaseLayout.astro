---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LocalSchema from '../components/LocalSchema.astro';
import StickyCallBar from '../components/StickyCallBar.astro';
import { site } from '../config/site';
import { getFontTheme } from '../config/fonts';
import { resolvePageTitle } from '../lib/page-title';
import { sitePath } from '../lib/site-path';

interface Props {
  title: string;
  description: string;
  pageType?: 'home' | 'service' | 'location' | 'page';
  serviceName?: string;
  locationCity?: string;
  /** Absolute or site-relative path for og:image / twitter:image */
  ogImage?: string;
  faqs?: Array<{ question: string; answer: string }>;
}

const {
  title,
  description,
  pageType = 'page',
  serviceName,
  locationCity,
  ogImage,
  faqs = [],
} = Astro.props;

const fullTitle = resolvePageTitle(title, site.businessName, 60);
const pathname = Astro.url.pathname || '/';
/** Home and every other page use a trailing slash (`https://domain/`). */
const canonicalUrl = `https://${site.domain}${sitePath(pathname)}`;

const defaultOg =
  site.logo?.src ||
  '/favicon.svg';
const ogImageRaw = String(ogImage || defaultOg).trim();
const ogImageAbs = ogImageRaw.startsWith('http')
  ? ogImageRaw
  : `https://${site.domain}${ogImageRaw.startsWith('/') ? '' : '/'}${ogImageRaw}`;

const loadVisualBridge = import.meta.env.PUBLIC_ROVER_VE === '1';
const fontTheme = getFontTheme(site.brand?.fontTheme);

function faviconTypeFromHref(href: string): string {
  const pathOnly = String(href || '').split('?')[0].toLowerCase();
  if (pathOnly.endsWith('.svg')) return 'image/svg+xml';
  if (pathOnly.endsWith('.png')) return 'image/png';
  if (pathOnly.endsWith('.ico')) return 'image/x-icon';
  if (pathOnly.endsWith('.webp')) return 'image/webp';
  if (pathOnly.endsWith('.jpg') || pathOnly.endsWith('.jpeg')) return 'image/jpeg';
  return 'image/png';
}

const faviconHref = String(site.logo?.src || '/favicon.svg').trim() || '/favicon.svg';
const faviconType = faviconTypeFromHref(faviconHref);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="icon" type={faviconType} href={faviconHref} />
    <link rel="apple-touch-icon" href={faviconHref} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link id="rover-site-fonts" href={fontTheme.googleHref} rel="stylesheet" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:site_name" content={site.businessName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />
    <title>{fullTitle}</title>
    <LocalSchema
      pageTitle={title}
      pageDescription={description}
      pageType={pageType}
      serviceName={serviceName}
      locationCity={locationCity}
      faqs={faqs}
      imageUrl={ogImageAbs}
    />
    <style is:inline set:html={`:root {
        --brand-primary: ${site.brand.primary};
        --brand-accent: ${site.brand.accent};
        --brand-ink: ${site.brand.ink};
        --font-display: ${fontTheme.displayStack};
        --font-body: ${fontTheme.bodyStack};
      }`}
    />
  </head>
  <body class="min-h-screen overflow-x-clip pb-24 md:pb-0">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <StickyCallBar />
    {loadVisualBridge && <script is:inline src="/rover-visual-bridge.js"></script>}
  </body>
</html>
