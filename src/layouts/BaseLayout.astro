---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LocalSchema from '../components/LocalSchema.astro';
import StickyCallBar from '../components/StickyCallBar.astro';
import { site } from '../config/site';

interface Props {
  title: string;
  description: string;
  pageType?: 'home' | 'service' | 'location' | 'page';
  serviceName?: string;
  locationCity?: string;
}

const {
  title,
  description,
  pageType = 'page',
  serviceName,
  locationCity,
} = Astro.props;

const fullTitle = title.includes(site.businessName) ? title : `${title} | ${site.businessName}`;
const canonical = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={`https://${site.domain}${canonical === '/' ? '' : canonical}`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800&family=Source+Sans+3:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`https://${site.domain}${canonical === '/' ? '' : canonical}`} />
    <title>{fullTitle}</title>
    <LocalSchema
      pageTitle={title}
      pageDescription={description}
      pageType={pageType}
      serviceName={serviceName}
      locationCity={locationCity}
    />
    <style
      define:vars={{
        brandPrimary: site.brand.primary,
        brandAccent: site.brand.accent,
        brandInk: site.brand.ink,
      }}
    >
      :root {
        --brand-primary: var(--brandPrimary);
        --brand-accent: var(--brandAccent);
        --brand-ink: var(--brandInk);
      }
    </style>
  </head>
  <body class="min-h-screen pb-20 md:pb-0">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <StickyCallBar />
  </body>
</html>
