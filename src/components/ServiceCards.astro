---
import { getCollection } from 'astro:content';
import { contentImageAlt, site, homepageServicesDisplayLimit, formatPhoneDisplay, phoneHref } from '../config/site';
import {
  applyServiceCardImages,
  commercialServiceCardsForSite,
  serviceCardsForSite,
} from '../lib/services-for-site';
import { fewCommercialGridClass, fitEqualGrid } from '../lib/equal-grid';
import { leadNiche } from '../lib/content-body';
import TwoToneHeading from './TwoToneHeading.astro';
import PhoneIcon from './PhoneIcon.astro';

interface Props {
  heading?: string;
  limit?: number;
  surface?: string;
  /** When set (location pages), blurbs use this city instead of primaryCity. */
  city?: string;
  /** Homepage FM serviceCardImages — fills What we do thumbs when service MD has no card art. */
  cardImages?: Array<{ src: string; alt: string }>;
}

const {
  heading = 'Services',
  limit,
  surface = 'section-surface-muted',
  city,
  cardImages = [],
} = Astro.props;

const entries = await getCollection('services');
const displayLimit = limit ?? homepageServicesDisplayLimit();
const residentialPainted = applyServiceCardImages(
  serviceCardsForSite(entries, site, displayLimit, city),
  cardImages,
  0,
);
const commercialPainted = applyServiceCardImages(
  commercialServiceCardsForSite(entries, site, displayLimit, city),
  cardImages,
  residentialPainted.nextIndex,
);
/** Default maxCols 4 → 8 cards = 2×4, 6 cards = 2×3 */
const residentialGrid = fitEqualGrid(residentialPainted.cards);
const commercialGrid = fitEqualGrid(commercialPainted.cards);
const residential = residentialGrid.items;
const commercial = commercialGrid.items;
const commercialClass =
  fewCommercialGridClass(commercial.length, {
    count: residential.length,
    className: residentialGrid.className,
  }) || commercialGrid.className;
const splitSections = commercial.length > 0;
const totalAvailable =
  serviceCardsForSite(entries, site, 12, city).length +
  commercialServiceCardsForSite(entries, site, 12, city).length;
const truncated = limit == null && totalAvailable > residential.length + commercial.length;
const blurbCity = String(city || site.primaryCity || '').trim() || 'your area';

const cardClass =
  'group flex w-full flex-col overflow-hidden rounded-lg border border-line bg-surface-raised shadow-sm transition hover:-translate-y-0.5 hover:border-brand/40 hover:shadow-md';
---

<section class={surface} aria-labelledby="services-heading" data-section="services">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-14">
    <div class="mb-6 max-w-2xl">
      <p class="section-eyebrow">What we do</p>
      <TwoToneHeading
        as="h2"
        id="services-heading"
        text={heading}
        niche={site.niche}
        emphasis="services"
        class="heading-section"
      />
      <p class="mt-2 text-sm text-muted">
        {leadNiche(`${site.niche} across ${blurbCity} and the surrounding area.`, site.niche)}
      </p>
    </div>

    {
      splitSections ? (
        <div class="space-y-10">
          {
            residential.length > 0 && (
              <div>
                <h3 class="font-display text-lg font-semibold tracking-tight text-ink">
                  Residential Services
                </h3>
                <ul class:list={['mt-4 grid gap-3', residentialGrid.className]}>
                  {residential.map((card) => (
                    <li class="flex">
                      <a href={card.href} class={cardClass}>
                        {card.image?.src && (
                          <img
                            src={card.image.src}
                            alt={contentImageAlt(card.image.alt)}
                            class="aspect-[16/10] w-full object-cover transition duration-300 group-hover:scale-[1.02]"
                            width="480"
                            height="300"
                            loading="lazy"
                          />
                        )}
                        <div class="flex grow flex-col p-4">
                          <h3 class="font-display text-base font-semibold leading-snug text-ink group-hover:text-brand">
                            {card.title}
                          </h3>
                          <p class="mt-1.5 line-clamp-2 text-sm leading-snug text-muted">
                            {card.description}
                          </p>
                          <span class="mt-auto pt-3 text-xs font-semibold text-accent-on-light group-hover:underline">
                            Learn more →
                          </span>
                        </div>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
          {
            commercial.length > 0 && (
              <div>
                <h3 class="font-display text-lg font-semibold tracking-tight text-ink">
                  Commercial Services
                </h3>
                <ul class:list={['mt-4 grid gap-3', commercialClass]}>
                  {commercial.map((card) => (
                    <li class="flex">
                      <a href={card.href} class={cardClass}>
                        {card.image?.src && (
                          <img
                            src={card.image.src}
                            alt={contentImageAlt(card.image.alt)}
                            class="aspect-[16/10] w-full object-cover transition duration-300 group-hover:scale-[1.02]"
                            width="480"
                            height="300"
                            loading="lazy"
                          />
                        )}
                        <div class="flex grow flex-col p-4">
                          <h3 class="font-display text-base font-semibold leading-snug text-ink group-hover:text-brand">
                            {card.title}
                          </h3>
                          <p class="mt-1.5 line-clamp-2 text-sm leading-snug text-muted">
                            {card.description}
                          </p>
                          <span class="mt-auto pt-3 text-xs font-semibold text-accent-on-light group-hover:underline">
                            Learn more →
                          </span>
                        </div>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </div>
      ) : (
        <ul class:list={['grid gap-3', residentialGrid.className]}>
          {residential.map((card) => (
            <li class="flex">
              <a href={card.href} class={cardClass}>
                {card.image?.src && (
                  <img
                    src={card.image.src}
                    alt={contentImageAlt(card.image.alt)}
                    class="aspect-[16/10] w-full object-cover transition duration-300 group-hover:scale-[1.02]"
                    width="480"
                    height="300"
                    loading="lazy"
                  />
                )}
                <div class="flex grow flex-col p-4">
                  <h3 class="font-display text-base font-semibold leading-snug text-ink group-hover:text-brand">
                    {card.title}
                  </h3>
                  <p class="mt-1.5 line-clamp-2 text-sm leading-snug text-muted">
                    {card.description}
                  </p>
                  <span class="mt-auto pt-3 text-xs font-semibold text-accent-on-light group-hover:underline">
                    Learn more →
                  </span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }

    {
      truncated && (
        <div class="mt-8 flex flex-col gap-4 border-t border-line pt-6 sm:flex-row sm:items-center sm:justify-between">
          <p class="max-w-xl text-sm leading-relaxed text-muted">
            Looking for something else? Browse all services in the menu, or tell us about a custom
            project.
          </p>
          <div class="flex shrink-0 flex-col gap-2 sm:flex-row sm:items-center">
            <a href="#lead-form" class="btn-primary">
              {site.primaryCta}
            </a>
            <a href={phoneHref()} class="btn-secondary hidden gap-2 md:inline-flex">
              <PhoneIcon />
              Call {formatPhoneDisplay()}
            </a>
          </div>
        </div>
      )
    }
  </div>
</section>
