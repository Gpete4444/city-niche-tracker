---
import { getCollection } from 'astro:content';
import { site, formatPhoneDisplay, phoneHref, siteShowsServicesNav } from '../config/site';
import { filterLocationsForSite } from '../lib/locations-for-site';
import {
  allConfiguredServiceNames,
  filterServicesByNames,
} from '../lib/services-for-site';
import { ve } from '../lib/visual-edit';
import { locationPath, servicePath, sitePath } from '../lib/site-path';
import { leadNiche } from '../lib/content-body';
import { fixSmallWords } from '../lib/small-words.mjs';
import PhoneIcon from './PhoneIcon.astro';

const services = filterServicesByNames(
  await getCollection('services'),
  allConfiguredServiceNames(site),
);
const locations = filterLocationsForSite(
  (await getCollection('locations')).filter((e) => !e.data.draft),
  site,
);

const showServicesNav = siteShowsServicesNav() && services.length > 0;
const showAreasNav = locations.length > 0;
const brandSubtitle = leadNiche(
  site.businessName.toLowerCase().includes(site.niche.toLowerCase())
    ? `${site.primaryCity}, ${site.state}`
    : `${site.niche} · ${site.primaryCity}, ${site.state}`,
  site.niche,
);

const navLinkClass =
  'whitespace-nowrap rounded-md px-2 py-1.5 text-sm font-medium text-ink/80 hover:bg-brand/5 hover:text-brand';
---

<header class="sticky top-0 z-[100] border-b border-line/80 bg-paper/95 backdrop-blur-sm">
  <div class="mx-auto flex max-w-6xl items-center gap-3 px-4 py-3 sm:gap-4 sm:px-6">
    <a href="/" class="flex min-w-0 shrink items-center gap-2.5 sm:gap-3">
      {
        site.logo?.src && (
          <img
            src={site.logo.src}
            alt={site.logo.alt || `${site.businessName} logo`}
            class="size-9 shrink-0 rounded-lg object-contain sm:size-10"
            width="40"
            height="40"
          />
        )
      }
      <span class="min-w-0">
        <span
          class="block truncate font-display text-sm font-bold tracking-tight text-brand sm:text-base lg:text-lg"
          data-edit={ve({ type: 'config', key: 'businessName', kind: 'text' })}
        >
          {site.businessName}
        </span>
        <span class="block truncate text-[0.7rem] text-muted sm:text-xs">
          {brandSubtitle}
        </span>
      </span>
    </a>

    <nav
      class="hidden min-w-0 flex-1 overflow-x-auto [-ms-overflow-style:none] [scrollbar-width:none] md:block min-[920px]:min-w-max min-[920px]:flex-none [&::-webkit-scrollbar]:hidden"
      aria-label="Primary"
    >
      <div class="flex items-center justify-start gap-0.5 sm:gap-1 lg:gap-2">
        <a class={navLinkClass} href="/">Home</a>
        {
          showServicesNav && (
            <div class="nav-menu relative shrink-0">
              <button
                type="button"
                class:list={[navLinkClass, 'nav-menu-trigger inline-flex items-center gap-1']}
                aria-expanded="false"
                aria-haspopup="true"
                aria-controls="nav-services-menu"
                id="nav-services-btn"
              >
                Services
                <span class="text-[0.65em] text-muted" aria-hidden="true">
                  ▾
                </span>
              </button>
              <ul
                id="nav-services-menu"
                class="nav-menu-panel fixed z-[110] hidden max-h-[min(24rem,70vh)] min-w-[16rem] overflow-y-auto rounded-lg border border-line bg-paper py-1 shadow-xl"
                role="menu"
                aria-labelledby="nav-services-btn"
              >
                {services.map((svc) => (
                  <li role="none">
                    <a
                      role="menuitem"
                      class="block px-3 py-2 text-sm text-ink/90 hover:bg-brand/5 hover:text-brand"
                      href={servicePath(svc.id)}
                    >
                      {fixSmallWords(svc.data.serviceName)}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        {
          showAreasNav && (
            <div class="nav-menu relative shrink-0">
              <button
                type="button"
                class:list={[navLinkClass, 'nav-menu-trigger inline-flex items-center gap-1']}
                aria-expanded="false"
                aria-haspopup="true"
                aria-controls="nav-locations-menu"
                id="nav-locations-btn"
              >
                Locations
                <span class="text-[0.65em] text-muted" aria-hidden="true">
                  ▾
                </span>
              </button>
              <ul
                id="nav-locations-menu"
                class="nav-menu-panel fixed z-[110] hidden max-h-[min(24rem,70vh)] min-w-[14rem] overflow-y-auto rounded-lg border border-line bg-paper py-1 shadow-xl"
                role="menu"
                aria-labelledby="nav-locations-btn"
              >
                {locations.map((loc) => (
                  <li role="none">
                    <a
                      role="menuitem"
                      class="block px-3 py-2 text-sm text-ink/90 hover:bg-brand/5 hover:text-brand"
                      href={locationPath(loc.id)}
                    >
                      {loc.data.city}, {loc.data.state}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        <a class={navLinkClass} href={sitePath('/about')}>About</a>
        <a class={navLinkClass} href={sitePath('/contact')}>Contact</a>
      </div>
    </nav>

    <details class="relative ml-auto md:hidden">
      <summary
        class="cursor-pointer list-none rounded-md px-3 py-1.5 text-sm font-medium text-ink/80 hover:bg-brand/5 hover:text-brand [&::-webkit-details-marker]:hidden"
      >
        Menu
      </summary>
      <div
        class="absolute right-0 top-full z-[110] mt-1 max-h-[min(24rem,70vh)] w-64 overflow-y-auto rounded-lg border border-line bg-paper py-1 shadow-xl"
      >
        <a class="block px-3 py-2 text-sm text-ink/90 hover:bg-brand/5 hover:text-brand" href="/">Home</a>
        {
          showServicesNav &&
            services.map((svc) => (
              <a
                class="block px-3 py-2 text-sm text-ink/90 hover:bg-brand/5 hover:text-brand"
                href={servicePath(svc.id)}
              >
                {fixSmallWords(svc.data.serviceName)}
              </a>
            ))
        }
        {
          showAreasNav &&
            locations.map((loc) => (
              <a
                class="block px-3 py-2 text-sm text-ink/90 hover:bg-brand/5 hover:text-brand"
                href={locationPath(loc.id)}
              >
                {loc.data.city}, {loc.data.state}
              </a>
            ))
        }
        <a class="block px-3 py-2 text-sm text-ink/90 hover:bg-brand/5 hover:text-brand" href={sitePath('/about')}>
          About
        </a>
        <a class="block px-3 py-2 text-sm text-ink/90 hover:bg-brand/5 hover:text-brand" href={sitePath('/contact')}>
          Contact
        </a>
      </div>
    </details>

    <div class="hidden shrink-0 items-center gap-2 md:flex">
      <a
        href="#lead-form"
        class="btn-secondary px-3 py-2 text-xs sm:px-4 sm:text-sm"
        data-edit={ve({ type: 'config', key: 'primaryCta', kind: 'text' })}
      >
        {site.primaryCta}
      </a>
      <a
        href={phoneHref()}
        class="btn-primary gap-2 px-3 py-2 text-xs sm:px-4 sm:text-sm"
        aria-label={`Call ${formatPhoneDisplay()}`}
        data-edit={ve({ type: 'config', key: 'phone', kind: 'text' })}
      >
        <PhoneIcon />
        <span class="hidden xl:inline">{formatPhoneDisplay()}</span>
      </a>
    </div>
  </div>
</header>

<script>
  function positionPanel(btn, panel) {
    const rect = btn.getBoundingClientRect();
    const gap = 4;
    const maxWidth = Math.min(320, window.innerWidth - 16);
    panel.style.minWidth = `${Math.max(rect.width, 224)}px`;
    panel.style.maxWidth = `${maxWidth}px`;
    let left = rect.left;
    if (left + maxWidth > window.innerWidth - 8) {
      left = Math.max(8, window.innerWidth - maxWidth - 8);
    }
    panel.style.left = `${left}px`;
    panel.style.top = `${rect.bottom + gap}px`;
  }

  function closeAllMenus(except = null) {
    document.querySelectorAll('.nav-menu').forEach((menu) => {
      if (except && menu === except) return;
      const btn = menu.querySelector('.nav-menu-trigger');
      const panel = menu.querySelector('.nav-menu-panel');
      if (btn) btn.setAttribute('aria-expanded', 'false');
      panel?.classList.add('hidden');
    });
  }

  document.querySelectorAll('.nav-menu').forEach((menu) => {
    const btn = menu.querySelector('.nav-menu-trigger');
    const panel = menu.querySelector('.nav-menu-panel');
    if (!btn || !panel) return;

    btn.addEventListener('click', (ev) => {
      ev.preventDefault();
      ev.stopPropagation();
      const open = btn.getAttribute('aria-expanded') === 'true';
      closeAllMenus();
      if (!open) {
        btn.setAttribute('aria-expanded', 'true');
        positionPanel(btn, panel);
        panel.classList.remove('hidden');
      }
    });

    panel.addEventListener('click', (ev) => ev.stopPropagation());
  });

  document.addEventListener('click', () => closeAllMenus());
  document.addEventListener('keydown', (ev) => {
    if (ev.key === 'Escape') closeAllMenus();
  });
  window.addEventListener(
    'resize',
    () => {
      document.querySelectorAll('.nav-menu').forEach((menu) => {
        const btn = menu.querySelector('.nav-menu-trigger');
        const panel = menu.querySelector('.nav-menu-panel');
        if (!btn || !panel || panel.classList.contains('hidden')) return;
        positionPanel(btn, panel);
      });
    },
    { passive: true },
  );
  window.addEventListener(
    'scroll',
    () => {
      document.querySelectorAll('.nav-menu').forEach((menu) => {
        const btn = menu.querySelector('.nav-menu-trigger');
        const panel = menu.querySelector('.nav-menu-panel');
        if (!btn || !panel || panel.classList.contains('hidden')) return;
        positionPanel(btn, panel);
      });
    },
    { passive: true },
  );
</script>
