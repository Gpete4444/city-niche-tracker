---
import { site, formatPhoneDisplay, phoneHref } from '../config/site';
import { fitEqualGrid } from '../lib/equal-grid';
import { sentenceCaseLine } from '../lib/content-body';
import {
  SURFACE_BRAND,
  SURFACE_INK,
  bandSurface,
} from '../lib/section-surfaces';
import { defaultSectionCtaPrompt } from '../lib/section-ctas';
import { WHY_ICON_PATHS, assignUniqueWhyIcons } from '../lib/why-icons';
import { loadInlineCoverageMapHtml } from '../lib/coverage-map-links';
import TwoToneHeading from './TwoToneHeading.astro';
import TypedProseSection from './sections/TypedProseSection.astro';
import GoogleReviewCard from './GoogleReviewCard.astro';
import PhoneIcon from './PhoneIcon.astro';
import { ve } from '../lib/visual-edit';

interface TextItem {
  title: string;
  description: string;
  image?: ImageItem;
}

interface FaqItem {
  question: string;
  answer: string;
}

interface LocationItem {
  id?: string;
  city: string;
  state: string;
  href?: string;
}

interface ImageItem {
  src: string;
  alt: string;
}

interface ProseSection {
  id: string;
  heading: string;
  body: string;
  eyebrow?: string;
}

interface Props {
  whyChooseUs?: TextItem[];
  process?: TextItem[];
  faqs?: FaqItem[];
  locations?: LocationItem[];
  /** Coverage cities without a location page — contact chips. */
  alsoServing?: LocationItem[];
  gallery?: ImageItem[];
  coverageMap?: ImageItem;
  materialsImages?: ImageItem[];
  processHeading?: string;
  whyHeading?: string;
  showReviews?: boolean;
  showCta?: boolean;
  /** Next light-band index after intro/services (even = raised, odd = muted). */
  bandStart?: number;
  /** Structure-enabled body sections (cost, materials, …) */
  proseSections?: ProseSection[];
  editFile?: string;
  /** Astro keys in display order (subset HomeSections owns). */
  sectionOrder?: string[];
}

const {
  whyChooseUs: whyChooseUsRaw = [],
  process: processRaw = [],
  faqs = [],
  locations = [],
  alsoServing = [],
  gallery: galleryRaw = [],
  coverageMap,
  materialsImages = [],
  processHeading,
  whyHeading,
  showReviews = true,
  showCta = true,
  bandStart = 0,
  proseSections = [],
  editFile = 'src/content/pages/index.md',
  sectionOrder: sectionOrderProp,
} = Astro.props;
const reviewsRaw = showReviews ? (site.socialProof?.reviews ?? []) : [];

/** Why choose us: prefer 2×2 (maxCols 2). Process uses default maxCols 4 (6 → 3×2). */
const whyGrid = fitEqualGrid(whyChooseUsRaw, { maxCols: 2 });
const whyChooseUs = whyGrid.items;

// Keep all authored process steps; attach images by index when present
const processSource = processRaw.map((p) => ({
  ...p,
  image: p?.image?.src ? p.image : undefined,
}));
const processGrid = fitEqualGrid(processSource);
const galleryRawFiltered = (galleryRaw || []).filter((img) =>
  /gallery-ba-\d+-(before|after)\./i.test(String(img?.src || '')),
);
const baPairMap = new Map();
for (const img of galleryRawFiltered) {
  const m = String(img.src).match(/gallery-ba-(\d+)-(before|after)\./i);
  if (!m) continue;
  const idx = Number(m[1]);
  const role = m[2].toLowerCase();
  if (!baPairMap.has(idx)) baPairMap.set(idx, { before: null, after: null });
  baPairMap.get(idx)[role] = img;
}
const baPairs = [...baPairMap.keys()]
  .sort((a, b) => a - b)
  .map((idx) => baPairMap.get(idx))
  .filter((p) => p.before || p.after);
const reviewsGrid = fitEqualGrid(reviewsRaw, { maxCols: 3 });
const process = processGrid.items;
const reviews = reviewsGrid.items;

const proseById = new Map(proseSections.map((s) => [s.id, s]));

const defaultBodyOrder = [
  'whyChooseUs',
  'process',
  'offerProcess',
  'cost',
  'materials',
  'timeline',
  'codes',
  'diyVsPro',
  'whenToCall',
  'areas',
  'gallery',
  'reviews',
  'faqs',
  'cta',
];

const sectionOrderRaw = (sectionOrderProp?.length ? sectionOrderProp : defaultBodyOrder).filter(Boolean);
let processKeySeen = false;
const sectionOrder = sectionOrderRaw.filter((key) => {
  if (key === 'process' || key === 'offerProcess') {
    if (processKeySeen) return false;
    processKeySeen = true;
  }
  return true;
});

const willShow: Record<string, boolean> = {
  whyChooseUs: whyChooseUs.length > 0,
  process: process.length > 0,
  offerProcess: process.length > 0,
  areas: locations.length > 0,
  gallery: baPairs.length > 0,
  reviews: reviews.length > 0,
  faqs: faqs.length > 0,
  cta: showCta,
};
for (const p of proseSections) willShow[p.id] = true;

let band = bandStart;
const surfaceFor: Record<string, string> = {};
for (const key of sectionOrder) {
  if (!willShow[key]) continue;
  if (key === 'areas') {
    surfaceFor[key] = SURFACE_BRAND;
    continue;
  }
  if (key === 'cta') {
    surfaceFor[key] = SURFACE_INK;
    continue;
  }
  surfaceFor[key] = bandSurface(band++);
}

const areasCta = defaultSectionCtaPrompt('areas');
const processCta = defaultSectionCtaPrompt('process');
const whyCta = defaultSectionCtaPrompt('whyChooseUs');
const whyIcons = assignUniqueWhyIcons(whyChooseUs.map((item) => item.title));

/** Inline coverage SVG so area <a> links navigate (object/img cannot). */
const coverageMapHtml = loadInlineCoverageMapHtml(
  coverageMap?.src,
  site.primaryCity || '',
);
---

{
  sectionOrder.map((key) => (
    <>
      {key === 'whyChooseUs' && whyChooseUs.length > 0 && surfaceFor.whyChooseUs && (
        <section class={surfaceFor.whyChooseUs} aria-labelledby="why-heading" data-section="whyChooseUs">
          <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20">
            <div class="max-w-2xl">
              <p class="section-eyebrow">Why choose us</p>
              <TwoToneHeading
                as="h2"
                id="why-heading"
                text={whyHeading ?? `Straightforward ${site.niche} guidance`}
                class="mt-2 heading-section"
              />
            </div>
            <ul class:list={['mt-8 grid gap-6', whyGrid.className]}>
              {whyChooseUs.map((item, i) => {
                const iconId = whyIcons[i];
                const d = WHY_ICON_PATHS[iconId];
                return (
                  <li
                    class="border-l-2 border-accent pl-5"
                    data-edit={ve({
                      type: 'list',
                      file: editFile,
                      listKey: 'whyChooseUs',
                      index: i,
                      field: 'title',
                      kind: 'heading',
                      list: 'whyChooseUs',
                    })}
                  >
                    <div class="flex items-start gap-3">
                      <span
                        class="mt-0.5 flex size-9 shrink-0 items-center justify-center rounded-md bg-accent/15 text-accent"
                        aria-hidden="true"
                      >
                        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d={d} />
                        </svg>
                      </span>
                      <div>
                        <h3
                          class="font-display text-lg font-semibold text-ink"
                          data-edit={ve({
                            type: 'list',
                            file: editFile,
                            listKey: 'whyChooseUs',
                            index: i,
                            field: 'title',
                            kind: 'heading',
                          })}
                        >
                          {item.title}
                        </h3>
                        <p
                          class="mt-2 text-sm leading-relaxed text-muted"
                          data-edit={ve({
                            type: 'list',
                            file: editFile,
                            listKey: 'whyChooseUs',
                            index: i,
                            field: 'description',
                            kind: 'body',
                          })}
                        >
                          {item.description}
                        </p>
                      </div>
                    </div>
                  </li>
                );
              })}
            </ul>
            <div class="mt-4 flex flex-col items-stretch gap-3 sm:flex-row sm:flex-wrap sm:items-center">
              <p class="text-sm text-ink/80">{whyCta}</p>
              <a href="#lead-form" class="btn-primary w-full sm:w-auto">{site.primaryCta}</a>
              <a href={phoneHref()} class="btn-secondary hidden gap-2 md:inline-flex">
                <PhoneIcon />
                Call {formatPhoneDisplay()}
              </a>
            </div>
          </div>
        </section>
      )}

      {(key === 'process' || key === 'offerProcess') && process.length > 0 && surfaceFor[key] && (
        <section class={surfaceFor[key]} aria-labelledby="process-heading" data-section="process">
          <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20">
            <div class="max-w-2xl">
              <p class="section-eyebrow">How it works</p>
              <TwoToneHeading
                as="h2"
                id="process-heading"
                mode="plain"
                text={processHeading ?? `How our ${site.niche} process works`}
                class="mt-2 heading-section"
              />
            </div>
            <ol class:list={['mt-8 grid gap-4', processGrid.className]}>
              {process.map((item, index) => (
                <li class="overflow-hidden rounded-lg border border-line bg-surface-raised shadow-sm">
                  {item.image && (
                    <img
                      src={item.image.src}
                      alt={item.image.alt}
                      class="aspect-[4/3] w-full object-cover"
                      width="480"
                      height="360"
                      loading="lazy"
                      data-edit={ve({
                        type: 'image',
                        file: editFile,
                        listKey: 'process',
                        index,
                        nested: true,
                        kind: 'image',
                        slotKey: `process-${index + 1}`,
                      })}
                    />
                  )}
                  <div class="p-3 sm:p-4">
                    <span class="inline-flex items-center justify-center whitespace-nowrap rounded-full bg-brand px-2.5 py-1 text-xs font-bold text-white">
                      {`Step ${index + 1}`}
                    </span>
                    <h3
                      class="mt-2 font-display text-base font-semibold leading-snug text-ink"
                      data-edit={ve({
                        type: 'list',
                        file: editFile,
                        listKey: 'process',
                        index,
                        field: 'title',
                        kind: 'heading',
                      })}
                    >
                      {item.title}
                    </h3>
                    <p
                      class="mt-1 text-xs leading-snug text-muted sm:text-sm"
                      data-edit={ve({
                        type: 'list',
                        file: editFile,
                        listKey: 'process',
                        index,
                        field: 'description',
                        kind: 'body',
                      })}
                    >
                      {sentenceCaseLine(item.description)}
                    </p>
                  </div>
                </li>
              ))}
            </ol>
            <div class="mt-4 flex flex-col items-stretch gap-3 sm:flex-row sm:flex-wrap sm:items-center">
              <p class="text-sm text-ink/80">{processCta}</p>
              <a href="#lead-form" class="btn-primary w-full sm:w-auto">{site.primaryCta}</a>
              <a href={phoneHref()} class="btn-secondary hidden gap-2 md:inline-flex">
                <PhoneIcon />
                Call {formatPhoneDisplay()}
              </a>
            </div>
          </div>
        </section>
      )}

      {proseById.has(key) && surfaceFor[key] && (
        <TypedProseSection
          surface={surfaceFor[key]}
          headingId={`prose-${key}-heading`}
          eyebrow={proseById.get(key)!.eyebrow || key}
          heading={proseById.get(key)!.heading}
          body={proseById.get(key)!.body}
          variant={key}
          showMiniCta
          timelineCompact={key === 'timeline'}
          rowImages={key === 'materials' ? materialsImages : []}
          imageListKey={key === 'materials' ? 'materialsImages' : undefined}
          editFile={editFile}
        />
      )}

      {key === 'areas' && locations.length > 0 && (
        <section class={SURFACE_BRAND} aria-labelledby="areas-heading" data-section="areas">
          <div
            class:list={[
              'mx-auto max-w-6xl gap-8 px-4 py-14 sm:px-6 sm:py-16',
              coverageMap && 'grid lg:grid-cols-[minmax(280px,0.7fr)_minmax(0,1.3fr)] lg:items-center',
            ]}
          >
            <div>
              <p class="section-eyebrow !text-white/65">Where we work</p>
              <TwoToneHeading
                as="h2"
                id="areas-heading"
                text={`Serving ${site.primaryCity} and nearby communities`}
                tone="light"
                emphasis="and nearby communities"
                class="mt-2 heading-section"
              />
              <p class="mt-3 text-sm leading-relaxed text-white/75">
                Local pages for these communities. Nearby towns without a page are still in our service area.
              </p>
              <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-1">
                {locations.map((location) => (
                  <li>
                    <a
                      class="flex items-center justify-between rounded-md border border-white/20 bg-white/10 px-4 py-3 text-sm font-semibold transition hover:bg-white/20"
                      href={location.href || (location.id ? `/locations/${location.id}` : '/contact')}
                    >
                      <span>
                        {location.city}, {location.state}
                      </span>
                      <span aria-hidden="true">→</span>
                    </a>
                  </li>
                ))}
              </ul>
              <div class="mt-5">
                <p class="text-xs font-semibold uppercase tracking-wide text-white/55">Also serving</p>
                <p class="mt-2 text-sm leading-relaxed text-white/70">
                  {alsoServing.map((a, i) => (
                    <>
                      {i > 0 && <span class="text-white/35"> · </span>}
                      <a
                        class="underline decoration-white/30 underline-offset-2 hover:text-white"
                        href="/contact"
                      >
                        {a.city}
                      </a>
                    </>
                  ))}
                  {alsoServing.length > 0 && <span class="text-white/35"> · </span>}
                  <a
                    class="underline decoration-white/30 underline-offset-2 hover:text-white"
                    href="/contact"
                  >
                    and others
                  </a>
                </p>
              </div>
              <div class="mt-4 space-y-2">
                <p class="text-sm text-white/85">{areasCta}</p>
                <div class="flex flex-col gap-2 sm:flex-row sm:flex-wrap">
                  <a href="#lead-form" class="btn-primary w-full sm:w-auto">{site.primaryCta}</a>
                  <a
                    href={phoneHref()}
                    class="btn-secondary hidden gap-2 border-white/30 bg-white/10 text-white hover:bg-white/20 md:inline-flex"
                  >
                    <PhoneIcon />
                    Call {formatPhoneDisplay()}
                  </a>
                </div>
              </div>
            </div>
            {coverageMapHtml ? (
              <figure class="mt-8 lg:mt-0">
                <div class="coverage-map-embed" set:html={coverageMapHtml} />
                <figcaption class="mt-2 text-xs text-white/55">
                  Named cities have local pages; shaded areas are also in our service area. Confirm
                  availability for a specific address.
                </figcaption>
              </figure>
            ) : (
              coverageMap && (
                <figure class="mt-8 lg:mt-0">
                  <img
                    src={coverageMap.src}
                    alt={coverageMap.alt}
                    class="w-full rounded-xl bg-white shadow-2xl"
                    width="1000"
                    height="680"
                    loading="lazy"
                  />
                  <figcaption class="mt-2 text-xs text-white/55">
                    Named cities have local pages; shaded areas are also in our service area. Confirm
                    availability for a specific address.
                  </figcaption>
                </figure>
              )
            )}
          </div>
        </section>
      )}

      {key === 'gallery' && baPairs.length > 0 && surfaceFor.gallery && (
        <section class={surfaceFor.gallery} aria-labelledby="gallery-heading" data-section="gallery">
          <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20">
            <div class="max-w-2xl">
              <p class="section-eyebrow">Before &amp; after</p>
              <TwoToneHeading
                as="h2"
                id="gallery-heading"
                text="See the work up close"
                emphasis="up close"
                class="mt-2 heading-section"
              />
            </div>
            <ul class="mt-8 grid gap-6 sm:grid-cols-2">
              {baPairs.map((pair) => (
                <>
                  {pair.before && (
                    <li>
                      <figure>
                        <img
                          src={pair.before.src}
                          alt={pair.before.alt}
                          class="aspect-[4/3] w-full rounded-lg object-cover shadow-sm"
                          width="800"
                          height="600"
                          loading="lazy"
                        />
                        <figcaption class="heading-section mt-3 text-center font-display font-semibold tracking-tight text-ink">
                          Before
                        </figcaption>
                      </figure>
                    </li>
                  )}
                  {pair.after && (
                    <li>
                      <figure>
                        <img
                          src={pair.after.src}
                          alt={pair.after.alt}
                          class="aspect-[4/3] w-full rounded-lg object-cover shadow-sm"
                          width="800"
                          height="600"
                          loading="lazy"
                        />
                        <figcaption class="heading-section mt-3 text-center font-display font-semibold tracking-tight text-ink">
                          After
                        </figcaption>
                      </figure>
                    </li>
                  )}
                </>
              ))}
            </ul>
          </div>
        </section>
      )}

      {key === 'reviews' && reviews.length > 0 && surfaceFor.reviews && (
        <section class={surfaceFor.reviews} aria-labelledby="reviews-heading" data-section="reviews">
          <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20">
            <div class="text-center">
              <p class="section-eyebrow">Customer feedback</p>
              <TwoToneHeading
                as="h2"
                id="reviews-heading"
                text="What local customers say"
                emphasis="local customers say"
                class="mt-2 heading-section"
              />
            </div>
            <ul class:list={['mt-8 grid gap-5', reviewsGrid.className]}>
              {reviews.map((review) => (
                <GoogleReviewCard
                  quote={review.quote}
                  author={review.author}
                  rating={review.rating}
                  date={review.date}
                  avatarUrl={review.avatarUrl}
                  verified={review.verified}
                  source={review.source}
                  location={review.location}
                />
              ))}
            </ul>
          </div>
        </section>
      )}

      {key === 'faqs' && faqs.length > 0 && surfaceFor.faqs && (
        <section class={surfaceFor.faqs} aria-labelledby="faq-heading" data-section="faqs">
          <div class="mx-auto max-w-4xl px-4 py-14 sm:px-6 sm:py-20">
            <div>
              <p class="section-eyebrow">Common questions</p>
              <TwoToneHeading
                as="h2"
                id="faq-heading"
                mode="plain"
                text={`${site.niche} FAQs`}
                class="mt-2 heading-section"
              />
            </div>
            <div class="mt-8 divide-y divide-line border-y border-line">
              {faqs.map((faq, fi) => (
                <details class="group py-4">
                  <summary
                    class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink"
                    data-edit={ve({
                      type: 'list',
                      file: editFile,
                      listKey: 'faqs',
                      index: fi,
                      field: 'question',
                      kind: 'heading',
                    })}
                  >
                    {faq.question}
                    <span class="text-xl text-accent transition group-open:rotate-45" aria-hidden="true">
                      +
                    </span>
                  </summary>
                  <p
                    class="max-w-3xl pt-3 text-sm leading-relaxed text-muted"
                    data-edit={ve({
                      type: 'list',
                      file: editFile,
                      listKey: 'faqs',
                      index: fi,
                      field: 'answer',
                      kind: 'body',
                    })}
                  >
                    {faq.answer}
                  </p>
                </details>
              ))}
            </div>
          </div>
        </section>
      )}

      {key === 'cta' && showCta && (
        <section class={SURFACE_INK} aria-labelledby="final-cta-heading" data-section="cta">
          <div class="mx-auto max-w-5xl px-4 py-14 text-center sm:px-6 sm:py-16">
            <TwoToneHeading
              as="h2"
              id="final-cta-heading"
              text="Ready for a clear estimate?"
              tone="light"
              emphasis="clear estimate?"
              class="heading-section"
            />
            <p class="mx-auto mt-3 max-w-2xl text-white/75">
              Tell us about the project, or call to talk through options in {site.primaryCity}.
            </p>
            <div class="mt-7 flex flex-col justify-center gap-3 sm:flex-row">
              <a class="btn-primary" href="#lead-form">
                {site.primaryCta}
              </a>
              <a
                class="btn-secondary hidden gap-2 border-white/25 bg-white/10 text-white hover:bg-white/20 md:inline-flex"
                href={phoneHref()}
              >
                <PhoneIcon />
                Call {formatPhoneDisplay()}
              </a>
            </div>
          </div>
        </section>
      )}
    </>
  ))
}
