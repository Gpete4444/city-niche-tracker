---
import { site, trustStripLicenses, trustStripStatistics } from '../config/site';

const rating = site.socialProof?.rating;
const licenses = trustStripLicenses(site.socialProof);
const statistics = trustStripStatistics(site.socialProof);
const hasProof = Boolean(rating || licenses.length > 0 || statistics.length > 0);
---

{
  hasProof && (
    <section class="section-surface-raised border-b border-line" aria-label="Business credentials and statistics" data-section="trust">
      <div class="mx-auto flex max-w-6xl flex-wrap items-stretch justify-center divide-line px-4 sm:px-6 md:divide-x">
        {rating &&
          (rating.url ? (
            <a
              class="flex min-w-44 flex-1 flex-col items-center justify-center gap-0.5 px-5 py-5 text-center transition hover:bg-paper"
              href={rating.url}
              rel="noopener"
              target="_blank"
            >
              <strong class="text-sm leading-none text-ink">{rating.value.toFixed(1)} / 5</strong>
              <span class="text-sm leading-none tracking-tight text-amber-500" aria-hidden="true">★★★★★</span>
              <span class="text-xs leading-none text-muted">{rating.reviewCount} reviews on {rating.source}</span>
            </a>
          ) : (
            <div class="flex min-w-44 flex-1 flex-col items-center justify-center gap-0.5 px-5 py-5 text-center">
              <strong class="text-sm leading-none text-ink">{rating.value.toFixed(1)} / 5</strong>
              <span class="text-sm leading-none tracking-tight text-amber-500" aria-hidden="true">★★★★★</span>
              <span class="text-xs leading-none text-muted">{rating.reviewCount} reviews on {rating.source}</span>
            </div>
          ))}
        {statistics.map((stat) => (
          <div class="min-w-36 flex-1 px-5 py-5 text-center">
            <strong class="block font-display text-xl text-brand">{stat.value}</strong>
            <span class="block text-xs text-muted">{stat.label}</span>
          </div>
        ))}
        {licenses.map((license) => (
          <div class="min-w-44 flex-1 px-5 py-5 text-center">
            <strong class="block text-sm text-ink">{license.name}</strong>
            {(license.number || license.jurisdiction) && (
              <span class="block text-xs text-muted">
                {[license.number, license.jurisdiction].filter(Boolean).join(' · ')}
              </span>
            )}
          </div>
        ))}
      </div>
    </section>
  )
}
