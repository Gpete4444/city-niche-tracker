---
import { site } from '../config/site';
import { headingNicheCase } from '../lib/content-body';
import { preferAccentPhrase, splitTwoToneHeading } from '../lib/two-tone';

interface Props {
  as?: 'h1' | 'h2' | 'h3';
  text: string;
  /** Force accent substring; otherwise auto-split when mode is auto */
  emphasis?: string;
  /** Preferred phrases to accent when present (e.g. city) — tried before auto-split */
  prefer?: Array<string | null | undefined>;
  /** plain = never accent; auto = smart split (default) */
  mode?: 'auto' | 'plain';
  /** dark = ink page; light = on brand/ink hero */
  tone?: 'dark' | 'light';
  id?: string;
  class?: string;
  /** Site niche. A hero title, or a heading that contains the business name, title-cases every niche phrase. Other headings title-case it only when the line starts with it. */
  niche?: string;
}

const {
  as: Tag = 'h2',
  text,
  emphasis,
  prefer,
  mode = 'auto',
  tone = 'dark',
  id,
  class: className,
  niche,
} = Astro.props;

const headingText = headingNicheCase(text, niche, site.businessName, { hero: Tag === 'h1' });
let lead = headingText;
let accent: string | null = null;
let rest = '';

if (mode !== 'plain') {
  if (emphasis && headingText.includes(emphasis)) {
    const idx = headingText.indexOf(emphasis);
    lead = headingText.slice(0, idx).trimEnd();
    accent = emphasis.trim();
    rest = headingText.slice(idx + emphasis.length);
  } else if (prefer?.length) {
    const parts = preferAccentPhrase(headingText, prefer);
    lead = parts.lead;
    accent = parts.accent;
    rest = parts.rest || '';
  } else {
    const parts = splitTwoToneHeading(headingText);
    lead = parts.lead;
    accent = parts.accent;
    rest = parts.rest || '';
  }
}

const leadClass = tone === 'light' ? 'text-white' : 'text-ink';
const accentClass =
  tone === 'light' ? 'font-semibold italic text-accent' : 'font-semibold italic text-accent-on-light';
---

<Tag
  id={id}
  class:list={[
    'font-display font-bold tracking-tight',
    leadClass,
    className,
  ]}
>
  {lead}
  {
    accent && (
      <>
        {' '}
        <span class={accentClass}>{accent}</span>
      </>
    )
  }
  {rest}
</Tag>
