---
import { site } from '../config/site';

interface Props {
  heading?: string;
  compact?: boolean;
}

const { heading = 'Get a free estimate', compact = false } = Astro.props;
const hasTurnstile = Boolean(site.turnstileSiteKey);
const ingestUrl = site.formsIngestUrl || '';
---

<section
  id="lead-form"
  class:list={[
    compact
      ? 'rounded-xl bg-surface-raised p-4 text-ink shadow-2xl shadow-black/25 sm:p-5 lg:p-6'
      : 'section-surface-raised',
  ]}
  aria-labelledby="form-heading"
>
  <div class:list={[!compact && 'mx-auto max-w-5xl px-4 py-12 sm:px-6 sm:py-16']}>
    <div data-rover-intro class:list={['max-w-xl', !compact && 'mx-auto text-center']}>
      <h2
        id="form-heading"
        class:list={[
          'font-display font-bold tracking-tight text-ink',
          compact ? 'heading-section' : 'heading-section',
        ]}
      >
        {heading}
      </h2>
      <p class:list={['text-muted', compact ? 'mt-1 text-sm' : 'mt-2']}>
        Tell us about the project and how to reach you.
      </p>
    </div>

    <form
      class:list={[
        'grid max-w-xl',
        compact ? 'mt-4 gap-3 lg:mt-5' : 'mx-auto mt-8 gap-4',
      ]}
      method="POST"
      data-rover-form
    >
      <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

      <div>
        <label class="label" for="name">Name</label>
        <input class="field" id="name" name="name" type="text" required autocomplete="name" />
      </div>

      <div>
        <label class="label" for="phone">Phone</label>
        <input class="field" id="phone" name="phone" type="tel" required autocomplete="tel" />
      </div>

      {
        !compact && (
          <div>
            <label class="label" for="email">Email (optional)</label>
            <input class="field" id="email" name="email" type="email" autocomplete="email" />
          </div>
        )
      }

      <div>
        <label class="label" for="service">What do you need?</label>
        <select class="field" id="service" name="service" required>
          <option value="" disabled selected>Select a service</option>
          {site.services.map((service) => <option value={service}>{service}</option>)}
          <option value="Other / Not sure">Other / Not sure</option>
        </select>
      </div>

      <div>
        <label class="label" for="message">Details</label>
        <textarea
          class:list={['field', compact ? 'min-h-20' : 'min-h-28']}
          id="message"
          name="message"
          rows={compact ? 2 : 4}
          placeholder="City, project details, anything we should know…"
          required={!compact}
        ></textarea>
      </div>

      {
        hasTurnstile && (
          <div class="turnstile-slot">
            <div
              class="cf-turnstile"
              data-sitekey={site.turnstileSiteKey}
              data-theme="auto"
              data-callback="roverTurnstilePassed"
              data-expired-callback="roverTurnstileCleared"
              data-error-callback="roverTurnstileCleared"
            />
            <input
              class="turnstile-gate"
              type="text"
              required
              tabindex="-1"
              autocomplete="off"
              aria-label="Verify you are human"
            />
          </div>
        )
      }

      <button type="submit" class:list={['btn-primary w-full disabled:cursor-wait disabled:opacity-70', !compact && 'sm:w-auto']}>
        {site.primaryCta}
      </button>
      <p class="form-status text-sm text-ink" data-rover-status hidden></p>
      {
        !ingestUrl && (
          <p class="text-xs text-ink">
            This form is not connected yet.
          </p>
        )
      }
    </form>
  </div>
</section>

{
  hasTurnstile && (
    <script is:inline>
      window.roverTurnstilePassed = (token) => {
        document.querySelectorAll('.turnstile-gate').forEach((input) => {
          input.value = token || '1';
          input.setCustomValidity('');
        });
      };
      window.roverTurnstileCleared = () => {
        document.querySelectorAll('.turnstile-gate').forEach((input) => {
          input.value = '';
          input.setCustomValidity('');
        });
      };
    </script>
  )
}
{hasTurnstile && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />}
<style>
  .turnstile-slot {
    position: relative;
    width: fit-content;
    max-width: 100%;
  }
  .turnstile-gate {
    position: absolute;
    left: 1.25rem;
    top: 1.35rem;
    width: 1.25rem;
    height: 1.25rem;
    margin: 0;
    padding: 0;
    border: 0;
    opacity: 0;
    pointer-events: none;
  }
</style>

<script define:vars={{ ingestUrl, domain: site.domain, phone: site.phone || '', hasTurnstile }}>
  const bind = (form) => {
    if (!(form instanceof HTMLFormElement) || form.dataset.roverInbox) return;
    form.dataset.roverInbox = '1';
    const status = form.querySelector('[data-rover-status]');
    const button = form.querySelector('button[type="submit"]');
    const label = button ? button.textContent : '';
    const showThanks = () => {
      const intro = form.closest('section')?.querySelector('[data-rover-intro]');
      if (intro) intro.hidden = true;
      form.hidden = true;
      const note = document.createElement('p');
      note.textContent = 'Thanks — we received your message.';
      form.insertAdjacentElement('afterend', note);
    };
    const showError = (text) => {
      if (status) {
        status.hidden = false;
        status.textContent = text;
      }
      if (button) {
        button.disabled = false;
        button.removeAttribute('aria-busy');
        button.textContent = label;
      }
      form.dataset.roverInboxSent = '';
    };
    const turnstileWidget = () => form.querySelector('.cf-turnstile');
    const turnstileGate = () => form.querySelector('.turnstile-gate');
    const promptTurnstile = () => {
      const gate = turnstileGate();
      if (!gate) return;
      gate.value = '';
      gate.setCustomValidity('');
      gate.reportValidity();
    };
    const turnstileToken = () => {
      const widget = turnstileWidget();
      if (!widget) return '';
      const api = window.turnstile;
      if (api && typeof api.getResponse === 'function') {
        const fromApi = api.getResponse(widget);
        if (fromApi) return String(fromApi);
      }
      return String(new FormData(form).get('cf-turnstile-response') || '');
    };
    const resetTurnstile = () => {
      const widget = turnstileWidget();
      const api = window.turnstile;
      if (widget && api && typeof api.reset === 'function') api.reset(widget);
    };
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (form.dataset.roverInboxSent === '1') return;
      const data = new FormData(form);
      if (String(data.get('botcheck') || '').trim()) {
        showThanks();
        return;
      }
      if (!ingestUrl) {
        showError(phone ? `This form is not connected yet. Please call ${phone}.` : 'This form is not connected yet.');
        return;
      }
      const humanToken = hasTurnstile ? turnstileToken() : '';
      if (hasTurnstile && !humanToken) {
        promptTurnstile();
        return;
      }
      form.dataset.roverInboxSent = '1';
      if (button) {
        button.disabled = true;
        button.setAttribute('aria-busy', 'true');
        button.textContent = 'Sending…';
      }
      if (status) status.hidden = true;
      const payload = {
        domain,
        deliver: true,
        page_url: location.href,
        name: String(data.get('name') || ''),
        phone: String(data.get('phone') || ''),
        email: String(data.get('email') || ''),
        service: String(data.get('service') || ''),
        message: String(data.get('message') || ''),
      };
      if (humanToken) payload.turnstileToken = humanToken;
      fetch(ingestUrl, {
        method: 'POST',
        mode: 'cors',
        headers: { 'Content-Type': 'text/plain;charset=UTF-8' },
        body: JSON.stringify(payload),
      })
        .then(async (res) => {
          let body = null;
          try {
            body = await res.json();
          } catch {
            body = null;
          }
          if (res.ok && body && body.ok !== false) {
            showThanks();
            return;
          }
          resetTurnstile();
          const code = body && body.error;
          if (code === 'turnstile_failed') {
            if (button) {
              button.disabled = false;
              button.removeAttribute('aria-busy');
              button.textContent = label;
            }
            form.dataset.roverInboxSent = '';
            promptTurnstile();
            return;
          }
          if (code === 'rate_limited') {
            showError(
              phone
                ? `Too many messages from this network. Please call ${phone} or try again later.`
                : 'Too many messages from this network. Please try again later.',
            );
            return;
          }
          if (body && body.stored) {
            showError(
              phone
                ? `We saved your message but could not email it. Please call ${phone}.`
                : 'We saved your message but could not email it. Please try again later.',
            );
            return;
          }
          showError(
            phone
              ? `We could not send your message. Please call ${phone}.`
              : 'We could not send your message. Please try again.',
          );
        })
        .catch(() => {
          resetTurnstile();
          showError(
            phone
              ? `We could not send your message. Please call ${phone}.`
              : 'We could not send your message. Please try again.',
          );
        });
    });
  };
  document.querySelectorAll('form[data-rover-form]').forEach(bind);
</script>
