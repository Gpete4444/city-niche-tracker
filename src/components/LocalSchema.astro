---
import { formatSiteStreet, publicTagline, site } from '../config/site';

interface Props {
  pageTitle?: string;
  pageDescription?: string;
  pageType?: 'home' | 'service' | 'location' | 'page';
  serviceName?: string;
  locationCity?: string;
  faqs?: Array<{ question: string; answer: string }>;
  imageUrl?: string;
}

const {
  pageDescription,
  pageType = 'page',
  serviceName,
  locationCity,
  faqs = [],
  imageUrl,
} = Astro.props;

const proof = site.socialProof;

const areaServed = [
  { '@type': 'City', name: site.primaryCity },
  ...site.targetSuburbs.map((name) => ({ '@type': 'City', name })),
];

const address: Record<string, string> = {
  '@type': 'PostalAddress',
  addressLocality: site.address?.city || site.primaryCity,
  addressRegion: site.address?.state || site.state,
  addressCountry: 'US',
};
if (site.address?.street) address.streetAddress = formatSiteStreet(site.address);
if (site.address?.zip) address.postalCode = site.address.zip;

const baseBusiness = {
  '@type': site.address?.street ? 'LocalBusiness' : 'ProfessionalService',
  '@id': `https://${site.domain}/#business`,
  name: site.businessName,
  description: pageDescription || publicTagline(site.tagline) || site.businessName,
  url: `https://${site.domain}/`,
  telephone: site.phone,
  email: site.email,
  image: imageUrl || `https://${site.domain}/favicon.svg`,
  areaServed,
  priceRange: '$$',
  address,
  ...(site.geo
    ? {
        geo: {
          '@type': 'GeoCoordinates',
          latitude: site.geo.lat,
          longitude: site.geo.lng,
        },
      }
    : {}),
  ...(proof?.rating
    ? {
        aggregateRating: {
          '@type': 'AggregateRating',
          ratingValue: proof.rating.value,
          reviewCount: proof.rating.reviewCount,
        },
      }
    : {}),
};

const graph: Record<string, unknown>[] = [baseBusiness];

if (pageType === 'service' && serviceName) {
  graph.push({
    '@type': 'Service',
    name: serviceName,
    provider: { '@id': `https://${site.domain}/#business` },
    areaServed,
    description: pageDescription ?? serviceName,
  });
}

if (pageType === 'location' && locationCity) {
  const primary = String(site.primaryCity || '').trim().toLowerCase();
  const loc = String(locationCity || '').trim().toLowerCase();
  const isPrimary = Boolean(primary && loc && primary === loc);
  graph.push({
    '@type': 'Service',
    name: isPrimary
      ? `${site.niche} neighborhoods in ${locationCity}`
      : `${site.niche} in ${locationCity}`,
    provider: { '@id': `https://${site.domain}/#business` },
    areaServed: [{ '@type': 'City', name: locationCity }],
    description:
      pageDescription ??
      (isPrimary
        ? `${site.niche} serving neighborhoods across ${locationCity}, ${site.state}`
        : `${site.niche} serving ${locationCity}, ${site.state}`),
  });
}

const cleanFaqs = (faqs || [])
  .map((f) => ({
    question: String(f?.question || '').trim(),
    answer: String(f?.answer || '').trim(),
  }))
  .filter((f) => f.question && f.answer);

if (cleanFaqs.length) {
  graph.push({
    '@type': 'FAQPage',
    mainEntity: cleanFaqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.answer,
      },
    })),
  });
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': graph,
};
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
