---
import { site, formatPhoneDisplay, phoneHref } from '../config/site';
import LeadForm from './LeadForm.astro';
import TwoToneHeading from './TwoToneHeading.astro';

interface Props {
  h1: string;
  supporting?: string;
  showCtas?: boolean;
  showForm?: boolean;
  image?: {
    src: string;
    alt: string;
  };
}

const {
  h1,
  supporting = site.tagline,
  showCtas = true,
  showForm = false,
  image,
} = Astro.props;
---

<section class="relative overflow-hidden border-b border-line bg-gradient-to-br from-brand via-brand to-ink text-white">
  {
    image && (
      <>
        <img
          src={image.src}
          alt={image.alt}
          class="absolute inset-0 size-full object-cover"
          width="1800"
          height="1000"
          fetchpriority="high"
        />
        <div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-ink/95 via-brand/85 to-ink/70" />
      </>
    )
  }
  <div
    class:list={['pointer-events-none absolute inset-0', image ? 'opacity-20' : 'opacity-30']}
    style="background-image: radial-gradient(circle at 18% 15%, rgba(255,255,255,0.14), transparent 42%), radial-gradient(circle at 85% 10%, rgba(232,163,23,0.28), transparent 38%), linear-gradient(145deg, transparent 0%, rgba(0,0,0,0.28) 100%);"
  >
  </div>
  <div
    class:list={[
      'relative mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16',
      showForm && 'grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(320px,420px)] lg:gap-14',
    ]}
  >
    <div class="animate-rise">
      <p class="mb-3 font-display text-sm font-bold uppercase tracking-[0.12em] text-accent sm:text-base">
        {site.businessName}
      </p>
      <TwoToneHeading
        as="h1"
        text={h1}
        tone="light"
        prefer={[
          site.primaryCity && site.state ? `in ${site.primaryCity}, ${site.state}` : null,
          site.primaryCity ? `in ${site.primaryCity}` : null,
          site.primaryCity,
        ]}
        class="max-w-3xl text-3xl leading-tight sm:text-5xl"
      />
      <p class="mt-4 max-w-2xl text-base text-white/85 sm:text-lg">
        {supporting}
      </p>
      {
        showCtas && !showForm && (
          <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:items-center">
            <a href="#lead-form" class="btn-primary bg-accent shadow-lg shadow-black/20">
              {site.primaryCta}
            </a>
            <a
              href={phoneHref()}
              class="btn-secondary border-white/30 bg-white/10 text-white hover:bg-white/20"
            >
              Call {formatPhoneDisplay()}
            </a>
          </div>
        )
      }
      {
        showCtas && showForm && (
          <div class="mt-7">
            <a
              href={phoneHref()}
              class="btn-secondary border-white/30 bg-white/10 text-white hover:bg-white/20"
            >
              Call {formatPhoneDisplay()}
            </a>
          </div>
        )
      }
      <p class="mt-4 text-sm text-white/70">
        Serving {site.primaryCity} and nearby communities
        {site.serviceRadiusMiles ? ` within ${site.serviceRadiusMiles} miles` : ''}.
      </p>
    </div>
    {
      showForm && (
        <div class="animate-rise-delay">
          <LeadForm compact heading="Get your free estimate" />
        </div>
      )
    }
  </div>
</section>
