---
import { site, formatPhoneDisplay, phoneHref, socialProofHasTrustStrip } from '../config/site';
import LeadForm from './LeadForm.astro';
import PhoneIcon from './PhoneIcon.astro';
import TwoToneHeading from './TwoToneHeading.astro';
import { ve } from '../lib/visual-edit';

interface Props {
  h1: string;
  supporting?: string;
  showCtas?: boolean;
  showForm?: boolean;
  image?: {
    src: string;
    alt: string;
  };
  /** Candidate markdown file for visual-edit bindings */
  editFile?: string;
  supportingKey?: 'tagline' | 'description';
  heroSlotKey?: string;
}

const {
  h1,
  supporting = site.tagline,
  showCtas = true,
  showForm = false,
  image,
  editFile,
  supportingKey = 'tagline',
  heroSlotKey = 'hero-1',
} = Astro.props;

const trustBits =
  socialProofHasTrustStrip(site.socialProof)
    ? [
        ...(site.socialProof?.statistics ?? [])
          .filter((s) => {
            const rating = site.socialProof?.rating;
            if (!rating) return true;
            const label = String(s.label || '');
            const value = String(s.value || '');
            if (/average\s+customer\s+rating/i.test(label)) return false;
            const num = parseFloat(value.replace(/[^\d.]/g, ''));
            if (
              Number.isFinite(num) &&
              Math.abs(num - rating.value) < 0.05 &&
              /rating|★|\*/i.test(`${value} ${label}`)
            ) {
              return false;
            }
            return true;
          })
          .slice(0, 2)
          .map((s) => `${s.value} ${s.label}`),
        ...(site.socialProof?.licenses ?? []).slice(0, 1).map((l) => l.name),
      ].slice(0, 3)
    : [];
---

<section
  class="relative overflow-hidden border-b border-line bg-gradient-to-br from-brand via-brand to-ink text-white"
  data-section="hero"
>
  {
    image && (
      <>
        <img
          src={image.src}
          alt={image.alt}
          class="absolute inset-0 size-full object-cover"
          width="1800"
          height="1000"
          fetchpriority="high"
          data-edit={
            editFile
              ? ve({
                  type: 'image',
                  file: editFile,
                  key: 'heroImage',
                  kind: 'image',
                  slotKey: heroSlotKey,
                })
              : undefined
          }
        />
        <div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-ink/95 via-brand/85 to-ink/70" />
      </>
    )
  }
  <div
    class:list={['pointer-events-none absolute inset-0', image ? 'opacity-20' : 'opacity-30']}
    style="background-image: radial-gradient(circle at 18% 15%, rgba(255,255,255,0.14), transparent 42%), radial-gradient(circle at 85% 10%, rgba(232,163,23,0.28), transparent 38%), linear-gradient(145deg, transparent 0%, rgba(0,0,0,0.28) 100%);"
  >
  </div>
  <div
    class:list={[
      'relative mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14 lg:py-16',
      showForm && 'grid items-center gap-8 sm:gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(320px,420px)] lg:gap-14',
    ]}
  >
    <div class="animate-rise">
      <p
        class="mb-3 font-display text-sm font-bold uppercase tracking-[0.12em] text-accent sm:text-base"
        data-edit={ve({ type: 'config', key: 'businessName', kind: 'text' })}
      >
        {site.businessName}
      </p>
      <div
        data-edit={
          editFile
            ? ve({ type: 'fm', file: editFile, key: 'h1', kind: 'heading' })
            : undefined
        }
      >
      <TwoToneHeading
        as="h1"
        text={h1}
        tone="light"
        prefer={[
          site.primaryCity && site.state ? `in ${site.primaryCity}, ${site.state}` : null,
          site.primaryCity ? `in ${site.primaryCity}` : null,
          site.primaryCity,
        ]}
        class="heading-display max-w-3xl"
      />
      </div>
      <p
        class="mt-4 max-w-2xl text-base text-white/85 sm:text-lg"
        data-edit={
          supportingKey === 'tagline'
            ? ve({ type: 'config', key: 'tagline', kind: 'body' })
            : editFile
              ? ve({ type: 'fm', file: editFile, key: 'description', kind: 'body' })
              : undefined
        }
      >
        {supporting}
      </p>
      {
        trustBits.length > 0 && (
          <ul class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm text-white/75">
            {trustBits.map((bit) => (
              <li class="flex items-center gap-2">
                <span class="text-accent" aria-hidden="true">
                  ✓
                </span>
                <span>{bit}</span>
              </li>
            ))}
          </ul>
        )
      }
      {
        showCtas && (
          <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:items-center">
            <a
              href="#lead-form"
              class="btn-primary bg-accent shadow-lg shadow-black/20"
              data-edit={ve({ type: 'config', key: 'primaryCta', kind: 'text' })}
            >
              {site.primaryCta}
            </a>
            <a
              href={phoneHref()}
              class="btn-secondary hidden gap-2 border-white bg-white text-ink hover:bg-white/90 md:inline-flex"
              data-edit={ve({ type: 'config', key: 'phone', kind: 'text' })}
            >
              <PhoneIcon />
              Call {formatPhoneDisplay()}
            </a>
          </div>
        )
      }
      <p class="mt-4 text-sm text-white/70">
        Serving {site.primaryCity} and nearby communities.
      </p>
    </div>
    {
      showForm && (
        <div class="mx-auto w-full max-w-md animate-rise-delay lg:mx-0 lg:max-w-none">
          <LeadForm compact heading="Get a free estimate" />
        </div>
      )
    }
  </div>
</section>
