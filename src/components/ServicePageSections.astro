---
import { formatPhoneDisplay, phoneHref, site } from '../config/site';
import { fitEqualGrid } from '../lib/equal-grid';
import { bandSurface, SURFACE_INK } from '../lib/section-surfaces';
import { simpleProseToHtml, sentenceCaseLine } from '../lib/content-body';
import { defaultSectionCtaPrompt } from '../lib/section-ctas';
import {
  parseServiceBody,
  type ServiceBodySection,
} from '../lib/service-body';
import TwoToneHeading from './TwoToneHeading.astro';
import TypedProseSection from './sections/TypedProseSection.astro';
import PhoneIcon from './PhoneIcon.astro';
import { ve } from '../lib/visual-edit';

interface RelatedCard {
  href: string;
  title: string;
  description: string;
  image?: { src: string; alt: string };
}

interface Props {
  body: string;
  h1?: string;
  title?: string;
  serviceName: string;
  related?: RelatedCard[];
  materialsImages?: Array<{ src: string; alt: string }>;
  processImages?: Array<{ src: string; alt: string }>;
  beforeAfterImages?: Array<{ src: string; alt: string }>;
  editFile?: string;
}

const {
  body,
  h1,
  title,
  serviceName,
  related: relatedRaw = [],
  materialsImages = [],
  processImages = [],
  beforeAfterImages = [],
  editFile = '',
} = Astro.props;
const parsed = parseServiceBody(body, { h1, title, serviceName });

const baRaw = (beforeAfterImages || []).filter((img) =>
  /svc-ba-.+-(before|after)\./i.test(String(img?.src || '')),
);
const baPairMap = new Map<number, { before: (typeof baRaw)[0] | null; after: (typeof baRaw)[0] | null }>();
for (const img of baRaw) {
  const m = String(img.src).match(/svc-ba-.+-(\d+)-(before|after)\./i);
  if (!m) continue;
  const idx = Number(m[1]);
  const role = m[2].toLowerCase() as 'before' | 'after';
  if (!baPairMap.has(idx)) baPairMap.set(idx, { before: null, after: null });
  baPairMap.get(idx)![role] = img;
}
const photoBaPairs = [...baPairMap.keys()]
  .sort((a, b) => a - b)
  .map((idx) => baPairMap.get(idx)!)
  .filter((p) => p.before && p.after);

/** Ippei: intro = max ~2 concise paragraphs. */
const introParagraphs = String(parsed.intro || '')
  .replace(/\r\n/g, '\n')
  .split(/\n{2,}/)
  .map((p) => p.trim())
  .filter(Boolean)
  .slice(0, 2);

const relatedGrid = fitEqualGrid(relatedRaw);
const related = relatedGrid.items;

const typedKinds = new Set([
  'scope',
  'cost',
  'materials',
  'timeline',
  'diy',
  'whenToCall',
  'codes',
  'other',
]);

const eyebrowFor = (kind: ServiceBodySection['kind']): string => {
  switch (kind) {
    case 'scope':
      return "What's included";
    case 'process':
      return 'How it works';
    case 'cost':
      return 'Cost';
    case 'materials':
      return 'Materials';
    case 'timeline':
      return 'Timeline';
    case 'faq':
      return 'FAQs';
    case 'diy':
      return 'DIY vs pro';
    case 'whenToCall':
      return 'When to call';
    case 'codes':
      return 'Codes & permits';
    case 'beforeAfter':
      return 'Before & after';
    case 'cta':
      return 'Next step';
    default:
      return serviceName;
  }
};

const typedVariant = (kind: ServiceBodySection['kind']): string => {
  if (kind === 'diy') return 'diyVsPro';
  if (kind === 'scope') return 'scope';
  return kind;
};

let band = 0;
/** Only advance for painted A/B bands — skip null sections and ink CTA. */
function nextBandSurface() {
  return bandSurface(band++);
}
const introSurface = introParagraphs.length ? nextBandSurface() : null;
---

{
  introParagraphs.length > 0 && introSurface && (
    <section class={introSurface} aria-label="Service overview">
      <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-12">
        <div
          class="prose-site max-w-3xl text-left"
          set:html={introParagraphs.map((p) => simpleProseToHtml(p)).join('\n')}
        />
      </div>
    </section>
  )
}

{
  parsed.sections.map((section, sectionIndex) => {
    if (section.kind === 'process' && section.steps?.length) {
      const paired =
        processImages.length > 0
          ? section.steps
              .slice(0, Math.min(section.steps.length, processImages.length))
              .map((step, i) => ({
                ...step,
                image: processImages[i]?.src ? processImages[i] : undefined,
              }))
          : section.steps.map((step) => ({ ...step, image: undefined as { src: string; alt: string } | undefined }));
      const stepsGrid = fitEqualGrid(paired);
      const steps = stepsGrid.items;
      if (!steps.length) return null;
      const surface = nextBandSurface();
      return (
        <section class={surface} aria-labelledby={`svc-process-${sectionIndex}`}>
          <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16">
            <div class="max-w-2xl">
              <p class="section-eyebrow">{eyebrowFor('process')}</p>
              <TwoToneHeading
                as="h2"
                id={`svc-process-${sectionIndex}`}
                mode="plain"
                text={section.heading}
                class="mt-2 heading-section"
              />
            </div>
            <ol class:list={['mt-8 grid gap-4', stepsGrid.className]}>
              {steps.map((step, index) => (
                <li class="overflow-hidden rounded-lg border border-line bg-surface-raised shadow-sm">
                  {step.image?.src && (
                    <img
                      src={step.image.src}
                      alt={step.image.alt}
                      class="aspect-[4/3] w-full object-cover"
                      width="480"
                      height="360"
                      loading="lazy"
                      data-edit={
                        editFile
                          ? ve({
                              type: 'image',
                              file: editFile,
                              listKey: 'processImages',
                              index,
                              kind: 'image',
                              slotKey: `svcProcess-${editFile.replace(/^.*\//, '').replace(/\.md$/, '')}-${index + 1}`,
                            })
                          : undefined
                      }
                    />
                  )}
                  <div class="p-3 sm:p-4">
                    <span class="inline-flex items-center justify-center whitespace-nowrap rounded-full bg-brand px-2.5 py-1 text-xs font-bold text-white">
                      {`Step ${index + 1}`}
                    </span>
                    <h3
                      class="mt-2 font-display text-base font-semibold leading-snug text-ink"
                      data-edit={
                        editFile
                          ? ve({
                              type: 'bodyStep',
                              file: editFile,
                              index,
                              field: 'title',
                              kind: 'heading',
                            })
                          : undefined
                      }
                    >
                      {step.title}
                    </h3>
                    <p
                      class="mt-1 text-xs leading-snug text-muted sm:text-sm"
                      data-edit={
                        editFile
                          ? ve({
                              type: 'bodyStep',
                              file: editFile,
                              index,
                              field: 'description',
                              kind: 'body',
                            })
                          : undefined
                      }
                    >
                      {sentenceCaseLine(step.description)}
                    </p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </section>
      );
    }

    if (section.kind === 'faq' && section.faqs?.length) {
      const surface = nextBandSurface();
      return (
        <section class={surface} aria-labelledby={`svc-faq-${sectionIndex}`}>
          <div class="mx-auto max-w-4xl px-4 py-14 sm:px-6 sm:py-16">
            <div>
              <p class="section-eyebrow">{eyebrowFor('faq')}</p>
              <TwoToneHeading
                as="h2"
                id={`svc-faq-${sectionIndex}`}
                mode="plain"
                text={section.heading}
                class="mt-2 heading-section"
              />
            </div>
            <div class="mt-8 divide-y divide-line border-y border-line">
              {section.faqs.map((faq) => (
                <details class="group py-4">
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink">
                    {faq.question}
                    <span class="text-xl text-accent transition group-open:rotate-45" aria-hidden="true">
                      +
                    </span>
                  </summary>
                  <p class="max-w-3xl pt-3 text-sm leading-relaxed text-muted">{faq.answer}</p>
                </details>
              ))}
            </div>
          </div>
        </section>
      );
    }

    if (section.kind === 'beforeAfter') {
      if (!photoBaPairs.length) return null;
      const surface = nextBandSurface();
      return (
        <section class={surface} aria-labelledby={`svc-ba-${sectionIndex}`}>
          <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16">
            <div class="max-w-2xl">
              <p class="section-eyebrow">{eyebrowFor('beforeAfter')}</p>
              <TwoToneHeading
                as="h2"
                id={`svc-ba-${sectionIndex}`}
                mode="plain"
                text={section.heading}
                class="mt-2 heading-section"
              />
            </div>
            <ul class="mt-8 grid gap-6 sm:grid-cols-2">
              {photoBaPairs.map((pair) => (
                <>
                  <li>
                    <figure>
                      <img
                        src={pair.before!.src}
                        alt={pair.before!.alt}
                        class="aspect-[4/3] w-full rounded-lg object-cover shadow-sm"
                        width="800"
                        height="600"
                        loading="lazy"
                      />
                      <figcaption class="heading-section mt-3 text-center font-display font-semibold tracking-tight text-ink">
                        Before
                      </figcaption>
                    </figure>
                  </li>
                  <li>
                    <figure>
                      <img
                        src={pair.after!.src}
                        alt={pair.after!.alt}
                        class="aspect-[4/3] w-full rounded-lg object-cover shadow-sm"
                        width="800"
                        height="600"
                        loading="lazy"
                      />
                      <figcaption class="heading-section mt-3 text-center font-display font-semibold tracking-tight text-ink">
                        After
                      </figcaption>
                    </figure>
                  </li>
                </>
              ))}
            </ul>
          </div>
        </section>
      );
    }

    if (section.kind === 'cta') {
      // Ink band is reserved — do not consume an A/B slot
      return (
        <section class={SURFACE_INK} aria-labelledby={`svc-cta-${sectionIndex}`}>
          <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-12 sm:flex-row sm:items-center sm:justify-between sm:px-6 sm:py-14">
            <div class="max-w-xl">
              <p class="section-eyebrow">{eyebrowFor('cta')}</p>
              <TwoToneHeading
                as="h2"
                id={`svc-cta-${sectionIndex}`}
                tone="light"
                mode="plain"
                text={section.heading}
                class="mt-2 heading-section"
              />
              {section.body && (
                <div
                  class="prose-site mt-3 max-w-xl text-sm leading-relaxed text-white/75 [&_a]:text-white [&_a]:underline [&_a]:decoration-white/40"
                  set:html={simpleProseToHtml(section.body)}
                />
              )}
            </div>
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
              <a href="#lead-form" class="btn-primary">
                {site.primaryCta}
              </a>
              <a
                href={phoneHref()}
                class="btn-secondary hidden gap-2 border-white/30 bg-white/10 text-white hover:bg-white/20 md:inline-flex"
              >
                <PhoneIcon />
                Call {formatPhoneDisplay()}
              </a>
            </div>
          </div>
        </section>
      );
    }

    if (typedKinds.has(section.kind)) {
      const surface = nextBandSurface();
      return (
        <TypedProseSection
          surface={surface}
          headingId={`svc-sec-${sectionIndex}`}
          eyebrow={eyebrowFor(section.kind)}
          heading={section.heading}
          body={section.body}
          variant={typedVariant(section.kind)}
          showMiniCta
          ctaPrompt={defaultSectionCtaPrompt(typedVariant(section.kind))}
          rowImages={section.kind === 'materials' ? materialsImages : []}
          imageListKey={section.kind === 'materials' ? 'materialsImages' : undefined}
          editFile={editFile}
        />
      );
    }

    return null;
  })
}

{
  related.length > 0 && (
    <section class={nextBandSurface()} aria-labelledby="related-services-heading">
      <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
        <div class="max-w-2xl">
          <p class="section-eyebrow">More services</p>
          <TwoToneHeading
            as="h2"
            id="related-services-heading"
            mode="plain"
            text={`Other ${site.niche} services`}
            class="mt-1.5 text-lg sm:text-xl"
          />
        </div>
        <ul class:list={['mt-4 grid gap-3', relatedGrid.className]}>
          {related.map((card) => (
            <li>
              <a
                href={card.href}
                class="group flex h-full items-center gap-3.5 rounded-lg border border-line bg-surface-raised px-3.5 py-3 transition hover:border-brand/40 hover:bg-surface"
              >
                {
                  card.image?.src && (
                    <img
                      src={card.image.src}
                      alt={card.image.alt || card.title}
                      class="size-20 shrink-0 rounded-md object-cover sm:size-24"
                      width="96"
                      height="96"
                      loading="lazy"
                    />
                  )
                }
                <div class="min-w-0 flex-1">
                  <h3 class="font-display text-sm font-semibold leading-snug text-ink line-clamp-2 group-hover:text-brand sm:text-base">
                    {card.title}
                  </h3>
                  <p class="mt-1 line-clamp-2 text-xs leading-snug text-muted sm:text-sm">
                    {card.description}
                  </p>
                </div>
                <span
                  class="flex size-9 shrink-0 items-center justify-center rounded-full bg-accent/15 text-xl font-bold text-accent transition group-hover:translate-x-0.5 group-hover:bg-accent/25 sm:size-10 sm:text-2xl"
                  aria-hidden="true"
                >
                  →
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

