---
import TwoToneHeading from '../TwoToneHeading.astro';
import PhoneIcon from '../PhoneIcon.astro';
import { formatPhoneDisplay, phoneHref, site } from '../../config/site';
import {
  extractMarkdownImage,
  inferDiyProFromProse,
  parseCodesColumns,
  parseCostRows,
  parseOptionRows,
  parseTimelineStages,
  proseIntroAndBullets,
  splitCompareColumns,
  stripBold,
} from '../../lib/section-parse';
import { simpleProseToHtml } from '../../lib/content-body';
import { defaultSectionCtaPrompt } from '../../lib/section-ctas';
import { ve } from '../../lib/visual-edit';
import { fitEqualGrid } from '../../lib/equal-grid';

interface Props {
  surface: string;
  headingId: string;
  eyebrow: string;
  heading: string;
  body: string;
  /** cost | materials | timeline | codes | diyVsPro | diy | whenToCall | scope | generic */
  variant?: string;
  showMiniCta?: boolean;
  ctaPrompt?: string;
  /** Per-row thumbs for materials (from frontmatter materialsImages). */
  rowImages?: Array<{ src: string; alt: string }>;
  /** Homepage timeline: title + duration chip only (no grey detail sublines). */
  timelineCompact?: boolean;
  editFile?: string;
  imageListKey?: string;
}

const {
  surface,
  headingId,
  eyebrow,
  heading,
  body: rawBody,
  variant = 'generic',
  showMiniCta = false,
  ctaPrompt,
  rowImages = [],
  timelineCompact = false,
  editFile = '',
  imageListKey,
} = Astro.props;

const { image, bodyWithoutImage } = extractMarkdownImage(rawBody);
const body = bodyWithoutImage;

const isDiy = variant === 'diyVsPro' || variant === 'diy';
const isMaterials = variant === 'materials';
const isTimeline = variant === 'timeline';
const isCodes = variant === 'codes';
const isCost = variant === 'cost';

const { introHtml, bullets } = proseIntroAndBullets(body);
const costRows = isCost ? parseCostRows(bullets) : [];
const optionRowsAll =
  isMaterials ||
  (isCost && !costRows.length) ||
  variant === 'whenToCall' ||
  variant === 'scope' ||
  variant === 'other' ||
  variant === 'generic'
    ? parseOptionRows(bullets)
    : [];
const materialsGrid = isMaterials ? fitEqualGrid(optionRowsAll, { maxCols: 3 }) : null;
const optionRows = isMaterials ? materialsGrid.items : optionRowsAll;
const materialsThumbs = isMaterials
  ? (rowImages || []).filter((img) => img?.src).slice(0, optionRows.length)
  : [];
const timelineStages = isTimeline ? parseTimelineStages(body) : [];
const codesCompare = isCodes ? parseCodesColumns(body) : null;
const codesIntroHtml =
  isCodes
    ? introHtml || codesCompare?.leftoverHtml || ''
    : '';
const bodyMentionsVerify = /verify|confirm.*(city|county|permit)|local (city|county)/i.test(
  `${body}\n${codesIntroHtml}`,
);
const showVerifyAside = isCodes && !bodyMentionsVerify && !codesIntroHtml;

let compare = isDiy ? splitCompareColumns(body) : null;
if (isDiy && compare && !compare.left.length && !compare.right.length) {
  const inferred = inferDiyProFromProse(body);
  compare = {
    ...compare,
    left: inferred.left,
    right: inferred.right,
    leftoverHtml: inferred.leftoverHtml || compare.leftoverHtml,
  };
}
// Last resort: balanced bullet split when writers omit ### DIY / ### Hire a pro
if (isDiy && compare && !compare.left.length && !compare.right.length && bullets.length >= 2) {
  const mid = Math.ceil(bullets.length / 2);
  compare = {
    ...compare,
    left: bullets.slice(0, mid),
    right: bullets.slice(mid),
    leftoverHtml: introHtml || compare.leftoverHtml,
  };
}

const htmlFallback =
  !bullets.length &&
  !(compare && (compare.left.length || compare.right.length)) &&
  !(codesCompare && (codesCompare.left.length || codesCompare.right.length)) &&
  !timelineStages.length &&
  !costRows.length
    ? simpleProseToHtml(body)
    : '';

const wide =
  isDiy ||
  isTimeline ||
  isCodes ||
  isCost ||
  isMaterials ||
  bullets.length > 3 ||
  Boolean(image) ||
  rowImages.length > 0;

const resolvedCta = showMiniCta
  ? (ctaPrompt || defaultSectionCtaPrompt(variant)).trim()
  : '';
---

<section class={surface} aria-labelledby={headingId} data-section={variant}>
  <div
    class:list={[
      'mx-auto px-4 py-12 sm:px-6 sm:py-14',
      wide ? 'max-w-6xl' : 'max-w-3xl',
    ]}
  >
    <p class="section-eyebrow">{eyebrow}</p>
    <TwoToneHeading
      as="h2"
      id={headingId}
      mode="plain"
      text={heading}
      class="mt-2 heading-section"
    />

    {
      isCost ? (
        <>
          {introHtml && <div class="prose-site mt-5 max-w-3xl" set:html={introHtml} />}
          {
            costRows.length > 0 ? (
              <>
                <div class="mt-8 overflow-x-auto rounded-lg border border-line shadow-sm">
                  <table class="w-full min-w-[36rem] border-collapse text-left text-sm">
                    <thead>
                      <tr class="bg-brand text-white">
                        <th class="px-4 py-3 font-display text-base font-semibold sm:px-5">
                          Project type
                        </th>
                        <th class="border-l border-white/20 px-4 py-3 font-display text-base font-semibold sm:px-5">
                          Typical range
                        </th>
                        <th class="border-l border-white/20 px-4 py-3 font-display text-base font-semibold sm:px-5">
                          What’s included
                        </th>
                      </tr>
                    </thead>
                    <tbody>
                      {costRows.map((row) => (
                        <tr class="border-t border-line odd:bg-surface-raised even:bg-paper">
                          <td class="px-4 py-3 font-semibold text-ink sm:px-5">{row.title}</td>
                          <td class="border-l border-line whitespace-nowrap px-4 py-3 font-display font-semibold text-brand sm:px-5">
                            {row.range}
                          </td>
                          <td class="border-l border-line px-4 py-3 text-muted sm:px-5">
                            {row.detail || '—'}
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
                <p class="mt-4 max-w-3xl text-sm leading-relaxed text-muted">
                  These are typical local ballparks — final cost depends on scope, materials, and site
                  conditions. A free estimate gives you an accurate, itemized number for your home.
                </p>
              </>
            ) : optionRows.length > 0 ? (
              <ul class="mt-6 max-w-3xl space-y-3 text-sm leading-relaxed text-muted">
                {optionRows.map((row) => (
                  <li class="flex gap-3">
                    <span class="mt-0.5 font-bold text-accent" aria-hidden="true">
                      ✓
                    </span>
                    <span>
                      <strong class="text-ink">{row.title}</strong>
                      {row.detail ? ` — ${row.detail}` : ''}
                    </span>
                  </li>
                ))}
              </ul>
            ) : htmlFallback && htmlFallback !== introHtml ? (
              <div class="prose-site mt-5 max-w-3xl" set:html={htmlFallback} />
            ) : null
          }
        </>
      ) : isMaterials ? (
        <div class="mt-6">
          {introHtml && <div class="prose-site max-w-3xl text-sm" set:html={introHtml} />}
          {
            optionRows.length > 0 ? (
              <ul class:list={['mt-6 grid gap-4', materialsGrid?.className || 'sm:grid-cols-2']}>
                {optionRows.map((row, i) => {
                  const thumb = materialsThumbs[i] || null;
                  return (
                    <li class="overflow-hidden rounded-lg border border-line bg-surface-raised shadow-sm">
                      {
                        thumb ? (
                          <img
                            src={thumb.src}
                            alt={thumb.alt || row.title}
                            class="aspect-[4/3] w-full object-cover"
                            width="480"
                            height="360"
                            loading="lazy"
                            decoding="async"
                            data-edit={
                              editFile
                                ? ve({
                                    type: 'image',
                                    file: editFile,
                                    listKey: imageListKey || 'materialsImages',
                                    index: i,
                                    kind: 'image',
                                    slotKey: `materials-${i + 1}`,
                                  })
                                : undefined
                            }
                          />
                        ) : null
                      }
                      <div class="p-3 sm:p-4">
                        <p class="font-display text-base font-semibold leading-snug text-ink">
                          {row.title}
                        </p>
                        {row.detail && (
                          <p class="mt-2 text-sm leading-relaxed text-muted">{row.detail}</p>
                        )}
                      </div>
                    </li>
                  );
                })}
              </ul>
            ) : htmlFallback ? (
              <div class="prose-site mt-5 text-sm" set:html={htmlFallback} />
            ) : null
          }
        </div>
      ) : isTimeline && timelineStages.length > 0 ? (
        <>
          {introHtml && bullets.length > 0 && (
            <div class="prose-site mt-5 max-w-3xl" set:html={introHtml} />
          )}
          <ol class="relative mt-8 space-y-0 border-l-2 border-accent/40 pl-0 sm:ml-3">
            {timelineStages.map((stage, i) => (
              <li class="relative pb-5 pl-10 last:pb-0">
                <span
                  class="absolute -left-[9px] top-1 flex size-4 items-center justify-center rounded-full border-2 border-accent bg-paper"
                  aria-hidden="true"
                />
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <span class="font-display text-sm font-bold tracking-wide text-accent">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <h3 class="font-display text-lg font-semibold text-ink">{stage.title}</h3>
                  {stage.duration && (
                    <span class="rounded-md bg-brand/10 px-2 py-0.5 text-xs font-semibold text-brand">
                      {stage.duration}
                    </span>
                  )}
                </div>
                {stage.detail && !timelineCompact && (
                  <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted">{stage.detail}</p>
                )}
              </li>
            ))}
          </ol>
        </>
      ) : isDiy && compare && (compare.left.length || compare.right.length) ? (
        <>
          {compare.leftoverHtml && (
            <div class="prose-site mt-5 max-w-3xl" set:html={compare.leftoverHtml} />
          )}
          <div class="mt-8 overflow-hidden rounded-lg border border-line shadow-sm">
            <table class="w-full border-collapse text-left text-sm">
              <thead>
                <tr class="bg-brand text-white">
                  <th class="w-1/2 px-4 py-3 font-display text-base font-semibold sm:px-5">
                    <span class="inline-flex items-center gap-2">
                      <svg class="size-4 opacity-80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
                      </svg>
                      {compare.leftTitle}
                    </span>
                  </th>
                  <th class="w-1/2 border-l border-white/20 px-4 py-3 font-display text-base font-semibold sm:px-5">
                    <span class="inline-flex items-center gap-2">
                      <svg class="size-4 opacity-80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M2 20h20M5 20V10l7-6 7 6v10M9 20v-6h6v6" />
                      </svg>
                      {compare.rightTitle}
                    </span>
                  </th>
                </tr>
              </thead>
              <tbody>
                {
                  Array.from({
                    length: Math.max(compare.left.length, compare.right.length),
                  }).map((_, i) => (
                    <tr class="border-t border-line odd:bg-surface-raised even:bg-paper">
                      <td class="align-top px-4 py-3 text-muted sm:px-5">
                        {compare.left[i] ? (
                          <span class="flex gap-2">
                            <span class="font-bold text-accent" aria-hidden="true">
                              ✓
                            </span>
                            <span>{stripBold(compare.left[i])}</span>
                          </span>
                        ) : (
                          <span class="text-line">—</span>
                        )}
                      </td>
                      <td class="align-top border-l border-line px-4 py-3 text-muted sm:px-5">
                        {compare.right[i] ? (
                          <span class="flex gap-2">
                            <span class="font-bold text-accent" aria-hidden="true">
                              ✓
                            </span>
                            <span>{stripBold(compare.right[i])}</span>
                          </span>
                        ) : (
                          <span class="text-line">—</span>
                        )}
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </>
      ) : isCodes ? (
        <>
          {codesIntroHtml && <div class="prose-site mt-5 max-w-3xl" set:html={codesIntroHtml} />}
          {
            codesCompare && (codesCompare.left.length || codesCompare.right.length) ? (
              <>
                <div class="mt-8 overflow-hidden rounded-lg border border-line shadow-sm">
                  <table class="w-full border-collapse text-left text-sm">
                    <thead>
                      <tr class="bg-brand text-white">
                        <th class="w-1/2 px-4 py-3 font-display text-base font-semibold sm:px-5">
                          Typically needs a permit
                        </th>
                        <th class="w-1/2 border-l border-white/20 px-4 py-3 font-display text-base font-semibold sm:px-5">
                          Often no permit
                        </th>
                      </tr>
                    </thead>
                    <tbody>
                      {
                        Array.from({
                          length: Math.max(codesCompare.left.length, codesCompare.right.length),
                        }).map((_, i) => (
                          <tr class="border-t border-line odd:bg-surface-raised even:bg-paper">
                            <td class="align-top px-4 py-3 text-muted sm:px-5">
                              {codesCompare.left[i] || '—'}
                            </td>
                            <td class="align-top border-l border-line px-4 py-3 text-muted sm:px-5">
                              {codesCompare.right[i] || '—'}
                            </td>
                          </tr>
                        ))
                      }
                    </tbody>
                  </table>
                </div>
              </>
            ) : bullets.length > 0 ? (
              <ul class="mt-6 grid gap-3 sm:grid-cols-2">
                {bullets.map((item) => (
                  <li class="flex gap-3 rounded-lg border border-line bg-surface-raised px-4 py-3 text-sm leading-relaxed text-ink/85">
                    <span
                      class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded border border-accent/40 bg-accent/10 text-[11px] font-bold text-accent"
                      aria-hidden="true"
                    >
                      ✓
                    </span>
                    <span>{stripBold(item)}</span>
                  </li>
                ))}
              </ul>
            ) : htmlFallback ? (
              <div class="prose-site mt-5" set:html={htmlFallback} />
            ) : null
          }
          {
            showVerifyAside && (
              <aside class="mt-6 text-sm leading-relaxed text-muted">
                <p>
                  Permit rules vary by city and county — confirm with {site.primaryCity} or{' '}
                  {site.state} before work begins.
                </p>
              </aside>
            )
          }
        </>
      ) : (
        <>
          {introHtml && <div class="prose-site mt-5" set:html={introHtml} />}
          {
            optionRows.length > 0 ? (
              <ul class="mt-6 space-y-3 text-sm leading-relaxed text-muted">
                {optionRows.map((row) => (
                  <li class="flex gap-3">
                    <span class="mt-0.5 font-bold text-accent" aria-hidden="true">
                      ✓
                    </span>
                    <span>
                      <strong class="text-ink">{row.title}</strong>
                      {row.detail ? ` — ${row.detail}` : ''}
                    </span>
                  </li>
                ))}
              </ul>
            ) : bullets.length > 0 ? (
              <ul class="mt-6 space-y-3 text-sm leading-relaxed text-muted">
                {bullets.map((item) => (
                  <li class="flex gap-3">
                    <span class="mt-0.5 font-bold text-accent" aria-hidden="true">
                      ✓
                    </span>
                    <span>{stripBold(item)}</span>
                  </li>
                ))}
              </ul>
            ) : null
          }
          {htmlFallback && !introHtml && !bullets.length && (
            <div class="prose-site mt-5" set:html={htmlFallback} />
          )}
        </>
      )
    }

    {
      showMiniCta && (
        <div class="mt-4 flex flex-col items-stretch gap-3 sm:flex-row sm:flex-wrap sm:items-center">
          {resolvedCta && <p class="text-sm text-ink/80">{resolvedCta}</p>}
          <a href="#lead-form" class="btn-primary w-full sm:w-auto">
            {site.primaryCta}
          </a>
          <a href={phoneHref()} class="btn-secondary hidden gap-2 md:inline-flex">
            <PhoneIcon />
            Call {formatPhoneDisplay()}
          </a>
        </div>
      )
    }
  </div>
</section>
